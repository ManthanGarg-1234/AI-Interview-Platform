--lp-surface: #111b2d;\n  --lp-ink: #edf2ff;\n  --lp-muted: #a4b0c5;\n  --lp-line: #26344a;\n  --lp-soft: #1b2540;\n  --lp-section: #0e1728;\n}\n.lp-nav {\n  width: min(1200px, calc(100% - 48px));\n  height: 82px;\n  margin: 0 auto;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 24px;\n}\n.lp-brand {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  color: var(--lp-ink);\n  font-size: 17px;\n  font-weight: 800;\n  letter-spacing: -0.04em;\n  text-decoration: none;\n  white-space: nowrap;\n}\n.lp-mark {\n  width: 36px;\n  height: 36px;\n  display: inline-grid;\n  place-items: center;\n  border-radius: 12px;\n  background: #4f46e5;\n  color: #fff;\n  font-size: 18px;\n  font-weight: 900;\n}\n.lp-brand-accent {\n  color: #6366f1;\n}\n.lp-nav-links, .lp-nav-actions {\n  display: flex;\n  align-items: center;\n  gap: 26px;\n}\n.lp-nav-links a, .lp-login, .lp-footer a {\n  color: var(--lp-muted);\n  font-size: 13px;\n  font-weight: 650;\n  text-decoration: none;\n  transition: color 160ms ease;\n}\n.lp-nav-links a:hover, .lp-login:hover, .lp-footer a:hover {\n  color: #6366f1;\n}\n.lp-nav-actions {\n  gap: 18px;\n}\n.lp-theme-toggle {\n  display: grid;\n  width: 38px;\n  height: 38px;\n  place-items: center;\n  border: 1px solid var(--lp-line);\n  border-radius: 12px;\n  background: var(--lp-surface);\n  color: var(--lp-ink);\n  transition: transform 160ms ease, border-color 160ms ease;\n}\n.lp-theme-toggle:hover {\n  transform: translateY(-1px);\n  border-color: #818cf8;\n}\n.lp-nav-cta {\n  min-height: 40px;\n  padding: 0 15px !important;\n  border-radius: 11px !important;\n  font-size: 13px !important;\n  text-decoration: none;\n}\n.lp-hero {\n  width: min(1200px, calc(100% - 48px));\n  min-height: 555px;\n  margin: 0 auto;\n  display: grid;\n  grid-template-columns: 1.05fr 0.95fr;\n  align-items: center;\n  gap: 44px;\n  padding: 53px 0 69px;\n}\n.lp-eyebrow {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  color: #5b5bd6;\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 0.13em;\n  text-transform: uppercase;\n}\n.lp-hero-copy h1 {\n  max-width: 660px;\n  margin: 22px 0 15px;\n  color: var(--lp-ink);\n  font-size: clamp(42px, 5vw, 66px);\n  font-weight: 780;\n  letter-spacing: -0.065em;\n  line-height: 1.04;\n}\n.lp-hero-copy h1 span, .lp-section-heading h2 span, .lp-deep-copy h2 span, .lp-recruiter-copy h2 span {\n  color: #5b5bd6;\n}\n.lp-hero-description {\n  margin: 0;\n  color: var(--lp-ink);\n  font-size: 17px;\n  font-weight: 700;\n  letter-spacing: -0.015em;\n}\n.lp-hero-subtext {\n  max-width: 510px;\n  margin: 14px 0 0;\n  color: var(--lp-muted);\n  font-size: 16px;\n  line-height: 1.8;\n}\n.lp-hero-actions {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 23px;\n  margin-top: 27px;\n}\n.lp-primary-cta {\n  min-height: 49px;\n  padding: 0 20px !important;\n  border-radius: 13px !important;\n  background: #4f46e5 !important;\n  color: #fff !important;\n  font-size: 14px !important;\n  text-decoration: none;\n  transition: background-color 160ms ease, transform 160ms ease;\n}\n.lp-primary-cta:hover {\n  transform: translateY(-1px);\n  background: #4338ca !important;\n}\n.lp-secondary-cta {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--lp-muted);\n  font-size: 13px;\n  font-weight: 700;\n  text-decoration: none;\n}\n.lp-secondary-cta:hover {\n  color: #4f46e5;\n}\n.lp-proof {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  margin-top: 30px;\n  color: var(--lp-muted);\n  font-size: 12px;\n}\n.lp-proof-icon {\n  display: grid;\n  width: 20px;\n  height: 20px;\n  place-items: center;\n  border-radius: 50%;\n  background: #dcfce7;\n  color: #15803d;\n}\n.lp-preview-wrap {\n  position: relative;\n  display: grid;\n  min-height: 390px;\n  place-items: center;\n  isolation: isolate;\n}\n.lp-orbit {\n  position: absolute;\n  z-index: -1;\n  border: 1px solid rgb(99 102 241 / 13%);\n  border-radius: 50%;\n}\n.lp-orbit-one {\n  width: 410px;\n  height: 410px;\n}\n.lp-orbit-two {\n  width: 330px;\n  height: 330px;\n  border-style: dashed;\n}\n.lp-preview-card {\n  position: relative;\n  width: min(440px, 100%);\n  padding: 25px !important;\n  border-color: var(--lp-line) !important;\n  border-radius: 22px !important;\n  background: var(--lp-surface) !important;\n  box-shadow: var(--shadow-card) !important;\n}\n.lp-preview-top {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 12px;\n}\n.lp-preview-kicker {\n  margin: 0 0 7px;\n  color: #818cf8;\n  font-size: 9px;\n  font-weight: 800;\n  letter-spacing: 0.13em;\n}\n.lp-preview-top h2 {\n  margin: 0;\n  color: var(--lp-ink);\n  font-size: 17px;\n  font-weight: 750;\n  letter-spacing: -0.025em;\n}\n.lp-live-dot {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  border-radius: 100px;\n  background: #ecfdf5;\n  padding: 6px 9px;\n  color: #047857;\n  font-size: 10px;\n  font-weight: 750;\n}\n.lp-live-dot::before {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: #10b981;\n  content: \"\";\n}\n.lp-preview-question {\n  display: flex;\n  align-items: flex-start;\n  gap: 12px;\n  margin-top: 24px;\n  border: 1px solid var(--lp-line);\n  border-radius: 14px;\n  background: var(--lp-bg);\n  padding: 16px;\n}\n.lp-question-number {\n  display: grid;\n  width: 29px;\n  height: 29px;\n  flex: 0 0 auto;\n  place-items: center;\n  border-radius: 9px;\n  background: var(--lp-soft);\n  color: #5756d8;\n  font-size: 11px;\n  font-weight: 800;\n}\n.lp-preview-question p {\n  margin: 1px 0 0;\n  color: var(--lp-ink);\n  font-size: 14px;\n  font-weight: 650;\n  line-height: 1.65;\n}\n.lp-audio-wave {\n  display: flex;\n  height: 66px;\n  align-items: center;\n  justify-content: center;\n  gap: 4px;\n  margin-top: 16px;\n}\n.lp-audio-wave i {\n  width: 3px;\n  height: var(--bar-height);\n  max-height: 52px;\n  border-radius: 4px;\n  background: linear-gradient(180deg, #818cf8, #6366f1);\n  opacity: 0.72;\n}\n.lp-audio-wave i:nth-child(3n) {\n  opacity: 0.38;\n}\n.lp-preview-bottom {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  border-top: 1px solid var(--lp-line);\n  padding-top: 15px;\n  color: var(--lp-muted);\n  font-size: 10px;\n}\n.lp-preview-bottom > span:first-child {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n}\n.lp-mic-dot {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: #818cf8;\n}\n.lp-floating-note {\n  position: absolute;\n  right: -18px;\n  bottom: 28px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  border: 1px solid var(--lp-line);\n  border-radius: 14px;\n  background: var(--lp-surface);\n  padding: 12px 15px;\n  box-shadow: var(--shadow-card);\n}\n.lp-note-icon {\n  display: grid;\n  width: 34px;\n  height: 34px;\n  place-items: center;\n  border-radius: 11px;\n  background: var(--lp-soft);\n  color: #5856dc;\n}\n.lp-floating-note strong, .lp-floating-note small {\n  display: block;\n}\n.lp-floating-note strong {\n  color: var(--lp-ink);\n  font-size: 11px;\n}\n.lp-floating-note small {\n  margin-top: 3px;\n  color: var(--lp-muted);\n  font-size: 10px;\n}\n.lp-trust-strip {\n  min-height: 74px;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: center;\n  gap: clamp(18px, 4vw, 52px);\n  border-top: 1px solid var(--lp-line);\n  border-bottom: 1px solid var(--lp-line);\n  background: var(--lp-section);\n  color: var(--lp-muted);\n}\n.lp-trust-strip p {\n  margin: 0;\n  font-size: 12px;\n}\n.lp-trust-strip span {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--lp-ink);\n  font-size: 12px;\n  font-weight: 700;\n}\n.lp-trust-strip span svg {\n  color: #6666df;\n}\n.lp-section {\n  width: min(1200px, calc(100% - 48px));\n  margin: 0 auto;\n  padding: 105px 0;\n}\n.lp-section-heading {\n  max-width: 660px;\n  margin: 0 auto 43px;\n  text-align: center;\n}\n.lp-section-heading h2, .lp-deep-copy h2, .lp-recruiter-copy h2 {\n  margin: 13px 0 12px;\n  color: var(--lp-ink);\n  font-size: clamp(30px, 3.6vw, 44px);\n  font-weight: 760;\n  letter-spacing: -0.05em;\n  line-height: 1.13;\n}\n.lp-section-heading > p, .lp-deep-copy > p, .lp-recruiter-copy > p {\n  margin: 0;\n  color: var(--lp-muted);\n  font-size: 14px;\n  line-height: 1.8;\n}\n.lp-feature-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 18px;\n}\n.lp-feature-card {\n  height: 100%;\n  padding: 26px !important;\n  border-color: var(--lp-line) !important;\n  border-radius: 18px !important;\n  background: var(--lp-surface) !important;\n  transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;\n}\n.lp-feature-card:hover {\n  transform: translateY(-4px);\n  border-color: #c7d2fe !important;\n  box-shadow: var(--shadow-card) !important;\n}\n.lp-feature-icon {\n  display: grid;\n  width: 44px;\n  height: 44px;\n  place-items: center;\n  border-radius: 14px;\n  background: var(--lp-soft);\n  color: #5756d8;\n}\n.lp-feature-label {\n  margin: 23px 0 8px;\n  color: #6366d8;\n  font-size: 10px;\n  font-weight: 800;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n}\n.lp-feature-card h3 {\n  margin: 0;\n  color: var(--lp-ink);\n  font-size: 19px;\n  font-weight: 750;\n  letter-spacing: -0.03em;\n  line-height: 1.35;\n}\n.lp-card-copy {\n  min-height: 75px;\n  margin: 12px 0 17px;\n  color: var(--lp-muted);\n  font-size: 13px;\n  line-height: 1.75;\n}\n.lp-feature-link {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  color: #5655d2;\n  font-size: 12px;\n  font-weight: 750;\n  text-decoration: none;\n}\n.lp-feature-link:hover {\n  gap: 11px;\n}\n.lp-deep-dive {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  align-items: center;\n  gap: 90px;\n  padding: 96px max(24px, calc((100% - 1140px) / 2));\n  background: var(--lp-section);\n}\n.lp-deep-copy {\n  max-width: 490px;\n}\n.lp-deep-copy h2, .lp-recruiter-copy h2 {\n  margin-top: 15px;\n  font-size: clamp(31px, 3.5vw, 43px);\n}\n.lp-deep-copy ul {\n  display: grid;\n  gap: 13px;\n  margin: 23px 0 27px;\n  padding: 0;\n  list-style: none;\n}\n.lp-deep-copy li {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  color: var(--lp-ink);\n  font-size: 13px;\n  font-weight: 650;\n}\n.lp-deep-copy li svg {\n  color: #10a878;\n}\n.lp-outline-cta {\n  min-height: 45px;\n  border-color: var(--lp-line) !important;\n  border-radius: 12px !important;\n  background: var(--lp-surface) !important;\n  color: var(--lp-ink) !important;\n  font-size: 12px !important;\n  text-decoration: none;\n}\n.lp-interview-art {\n  position: relative;\n  min-height: 320px;\n  display: grid;\n  place-items: center;\n  border: 1px solid var(--lp-line);\n  border-radius: 24px;\n  background: radial-gradient(ellipse at 70% 20%, rgb(129 140 248 / 18%), transparent 55%), var(--lp-bg);\n}\n.lp-art-window {\n  width: 77%;\n  overflow: hidden;\n  border: 1px solid var(--lp-line);\n  border-radius: 15px;\n  background: var(--lp-surface);\n  box-shadow: var(--shadow-card);\n  transform: rotate(-2deg);\n}\n.lp-art-window-bar {\n  height: 38px;\n  display: flex;\n  align-items: center;\n  gap: 5px;\n  border-bottom: 1px solid var(--lp-line);\n  padding: 0 12px;\n}\n.lp-art-window-bar i {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: #cbd5e1;\n}\n.lp-art-window-bar span {\n  margin-left: 9px;\n  color: var(--lp-muted);\n  font-size: 9px;\n}\n.lp-art-content {\n  display: grid;\n  grid-template-columns: 65px 1fr;\n  gap: 14px;\n  align-items: center;\n  padding: 24px;\n}\n.lp-art-avatar {\n  display: grid;\n  width: 58px;\n  height: 58px;\n  place-items: center;\n  border-radius: 18px;\n  background: linear-gradient(145deg, #e0e7ff, #c7d2fe);\n  color: #4338ca;\n  font-size: 12px;\n  font-weight: 800;\n}\n.lp-art-prompt span, .lp-art-prompt strong, .lp-art-prompt small {\n  display: block;\n}\n.lp-art-prompt span {\n  color: #6366d8;\n  font-size: 8px;\n  font-weight: 800;\n  letter-spacing: 0.12em;\n}\n.lp-art-prompt strong {\n  margin-top: 7px;\n  color: var(--lp-ink);\n  font-size: 13px;\n}\n.lp-art-prompt small {\n  margin-top: 6px;\n  color: var(--lp-muted);\n  font-size: 9px;\n  line-height: 1.6;\n}\n.lp-art-controls {\n  grid-column: 1 / -1;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  margin-top: 11px;\n  border-top: 1px solid var(--lp-line);\n  padding-top: 18px;\n}\n.lp-art-controls > span {\n  width: 24px;\n  height: 24px;\n  border-radius: 50%;\n  background: var(--lp-soft);\n}\n.lp-art-controls > span:nth-child(2) {\n  background: #fee2e2;\n}\n.lp-art-controls b {\n  border-radius: 9px;\n  background: #4f46e5;\n  padding: 8px 13px;\n  color: white;\n  font-size: 9px;\n}\n.lp-art-spark {\n  position: absolute;\n  top: 31px;\n  right: 36px;\n  display: grid;\n  width: 39px;\n  height: 39px;\n  place-items: center;\n  border: 1px solid var(--lp-line);\n  border-radius: 12px;\n  background: var(--lp-surface);\n  color: #6867dc;\n  box-shadow: var(--shadow-card);\n}\n.lp-resume-section {\n  background: var(--lp-bg);\n}\n.lp-resume-art {\n  position: relative;\n  width: min(360px, 100%);\n  min-height: 322px;\n  justify-self: center;\n  border: 1px solid var(--lp-line);\n  border-radius: 24px;\n  background: var(--lp-soft);\n  padding: 28px 34px;\n}\n.lp-resume-sheet {\n  min-height: 267px;\n  border: 1px solid var(--lp-line);\n  border-radius: 12px;\n  background: var(--lp-surface);\n  padding: 24px;\n  box-shadow: var(--shadow-card);\n  transform: rotate(2deg);\n}\n.lp-resume-heading, .lp-resume-line {\n  display: block;\n  height: 7px;\n  margin-bottom: 7px;\n  border-radius: 5px;\n  background: #d7dded;\n}\n.lp-resume-heading {\n  width: 47%;\n  height: 11px;\n  background: #8885ed;\n}\n.lp-resume-line {\n  width: 94%;\n  height: 5px;\n}\n.lp-resume-line.short {\n  width: 61%;\n  margin-bottom: 18px;\n}\n.lp-resume-section-title {\n  display: block;\n  margin: 12px 0 7px;\n  color: #8585cf;\n  font-size: 7px;\n  font-weight: 800;\n  letter-spacing: 0.1em;\n}\n.lp-skill-pills {\n  display: flex;\n  gap: 6px;\n  margin-top: 9px;\n}\n.lp-skill-pills i {\n  width: 38px;\n  height: 13px;\n  border-radius: 5px;\n  background: #e5e7ff;\n}\n.lp-skill-pills i:nth-child(2) {\n  width: 45px;\n}\n.lp-skill-pills i:nth-child(3) {\n  width: 33px;\n}\n.lp-skill-pills i:nth-child(4) {\n  width: 40px;\n}\n.lp-resume-score {\n  position: absolute;\n  right: -20px;\n  bottom: 25px;\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  border: 1px solid var(--lp-line);\n  border-radius: 13px;\n  background: var(--lp-surface);\n  padding: 11px 14px;\n  box-shadow: var(--shadow-card);\n}\n.lp-score-ring {\n  display: grid;\n  width: 30px;\n  height: 30px;\n  place-items: center;\n  border: 2px solid #6d64df;\n  border-radius: 50%;\n  color: #5d54d0;\n  font-size: 13px;\n  font-weight: 800;\n}\n.lp-resume-score b, .lp-resume-score small {\n  display: block;\n}\n.lp-resume-score b {\n  color: var(--lp-ink);\n  font-size: 10px;\n}\n.lp-resume-score small {\n  margin-top: 3px;\n  color: var(--lp-muted);\n  font-size: 9px;\n}\n.lp-coding-band {\n  width: min(1200px, calc(100% - 48px));\n  margin: 80px auto;\n  display: flex;\n  align-items: center;\n  gap: 22px;\n  border: 1px solid var(--lp-line);\n  border-radius: 22px;\n  background: var(--lp-surface);\n  padding: 30px 34px;\n}\n.lp-code-glyph {\n  display: grid;\n  width: 54px;\n  height: 54px;\n  flex: 0 0 auto;\n  place-items: center;\n  border-radius: 16px;\n  background: var(--lp-soft);\n  color: #5756d8;\n}\n.lp-coding-band > div:nth-child(2) {\n  flex: 1;\n}\n.lp-coding-band h2 {\n  margin: 6px 0 5px;\n  color: var(--lp-ink);\n  font-size: 20px;\n  font-weight: 750;\n  letter-spacing: -0.03em;\n}\n.lp-coding-band p {\n  margin: 0;\n  color: var(--lp-muted);\n  font-size: 12px;\n  line-height: 1.7;\n}\n.lp-recruiter-section {\n  display: grid;\n 