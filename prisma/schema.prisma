generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  RECRUITER
  ADMIN
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum CompanyStatus {
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
  REJECTED
}

enum CompanyMemberRole {
  OWNER
  HIRING_MANAGER
  REVIEWER
  INTERVIEWER
  ANALYST
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  SHORTLISTED
  ASSESSMENT
  TECHNICAL_INTERVIEW
  HR_INTERVIEW
  SELECTED
  REJECTED
  WITHDRAWN
}

enum EvidenceType {
  SELF_DECLARED
  CODING_RESULT
  ASSESSMENT_RESULT
  AI_INFERRED
  RECRUITER_VERIFIED
  PROJECT
  CERTIFICATION
}

enum AssessmentType {
  TECHNICAL
  APTITUDE
  CODING
  SQL
  SUBJECT
  PRACTICE
  RECRUITER
  CONTEST
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  GRADED
  EXPIRED
  CANCELLED
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  GRADED
}

enum SubmissionType {
  RUN
  PRACTICE
  CONTEST
}

enum ContestStatus {
  DRAFT
  PUBLISHED
  LIVE
  ENDED
  ARCHIVED
  CONTEST
  RECRUITER_ASSESSMENT
}

enum SubmissionStatus {
  RECEIVED
  VALIDATED
  QUEUED
  DISPATCHED
  RUNNING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

enum Verdict {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  COMPILATION_ERROR
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  INTERNAL_ERROR
}

enum InterviewType {
  AI_TECHNICAL
  AI_HR
  AI_BEHAVIORAL
  AI_MIXED
  RECRUITER_TECHNICAL
  RECRUITER_HR
}

enum InterviewStatus {
  DRAFT
  CONFIGURED
  QUESTION_GENERATING
  READY
  SCHEDULED
  IN_PROGRESS
  EVALUATING
  COMPLETED
  CANCELLED
  EXPIRED
}

enum RecruiterInterviewStatus {
  DRAFT
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RecruiterRoundStatus {
  PLANNED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LiveRoomStatus {
  WAITING
  ACTIVE
  COMPLETED
  EXPIRED
}

enum InterviewParticipantRole {
  CANDIDATE
  INTERVIEWER
  OBSERVER
}

enum RescheduleRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum ScorecardStatus {
  DRAFT
  SUBMITTED
  FINALIZED
  CORRECTED
}

enum ConsentType {
  PROFILE_DISCOVERY
  RESUME_SHARING
  ASSESSMENT_SHARING
  INTERVIEW_TRANSCRIPT
  AI_CONTEXT
  MEDIA_DEVICE
  RECORDING
  DATA_EXPORT
}

enum ConsentStatus {
  GRANTED
  REVOKED
  EXPIRED
}

enum ModerationStatus {
  FLAGGED
  INVESTIGATION
  EVIDENCE_REVIEW
  DECISION
  APPEAL
  CLOSED
}

enum RecommendationStatus {
  PROPOSED
  APPROVED
  REJECTED
  APPLIED
  EXPIRED
}

enum NotificationType {
  SYSTEM
  APPLICATION
  ASSESSMENT
  INTERVIEW
  JOB
  SECURITY
  MODERATION
}

enum FileScanStatus {
  PENDING
  CLEAN
  INFECTED
  REJECTED
  FAILED
  DELETED
}

enum FileRetentionClass {
  RESUME
  INTERVIEW_MEDIA
  MODERATION_EVIDENCE
  EXPORT_TEMP
}

enum AIMessageRole {
  USER
  ASSISTANT
}

enum AIMessageStatus {
  COMPLETE
  PARTIAL
  FAILED
  DELETED
}

enum AIRequestStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  REFUSED
}

model User {
  id                 String          @id @default(uuid()) @db.Uuid
  email              String          @unique @db.VarChar(320)
  passwordHash       String          @db.VarChar(255)
  role               UserRole
  status             AccountStatus   @default(PENDING_VERIFICATION)
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  suspendedAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  studentProfile     StudentProfile?
  recruiterProfile   RecruiterProfile?
  sessions           UserSession[]
  refreshTokens      RefreshToken[]  @relation("RefreshTokenUser")
  companyMembers     CompanyMember[]
  applications       Application[]   @relation("ApplicationStudent")
  createdJobs        Job[]            @relation("JobCreator")
  createdAssessments Assessment[]     @relation("AssessmentCreator")
  submissions        CodeSubmission[]
  assessmentAttempts AssessmentAttempt[]
  notifications      Notification[]
  notificationPreference NotificationPreference?
  consents           ConsentRecord[]
  conversations      AIConversation[]
  aiUsage            AIUsageRecord[]
  aiEvaluations      AIEvaluation[]
  bookmarks          Bookmark[]
  jobBookmarks       JobBookmark[]
  codingProgress     StudentProblemProgress[]
  codeRuns           CodeRun[]
  organizedContests  Contest[] @relation("ContestOrganizer")
  contestRegistrations ContestRegistration[]
  contestSubmissions ContestSubmission[]
  auditLogs          AuditLog[]       @relation("AuditActor")
  securityEvents     SecurityEvent[]  @relation("SecuritySubject")
  reportedCases      ModerationCase[] @relation("ModerationReporter")
  moderationCases    ModerationCase[] @relation("ModerationSubject")
  createdInterviews  InterviewSession[] @relation("InterviewCreator")
  interviewParticipants InterviewParticipant[]
  authoredNotes      RecruiterNote[]
  verifiedSkills     StudentSkill[]  @relation("SkillVerifier")
  assignedAssessments AssessmentAssignment[] @relation("AssignmentAssigner")
  assessmentReviews AssessmentReview[] @relation("AssessmentReviewer")
  completedTasks     StudyTaskCompletion[]
  createdFiles       StoredFile[]     @relation("FileOwner")
  dataAccesses       DataAccessLog[] @relation("DataAccessActor")
  subjectDataAccesses DataAccessLog[] @relation("DataAccessSubject")
  createdAuditEvents AuditLog[]       @relation("AuditCreatedBy")
  resolvedSecurityEvents SecurityEvent[] @relation("SecurityResolver")
  decidedModerationCases ModerationCase[] @relation("ModerationDecider")
  moderationActions ModerationAction[]
  appeals           Appeal[]
  receivedAssessments AssessmentAssignment[] @relation("AssessmentStudent")
  interviewAnswers  InterviewAnswer[] @relation("InterviewAnswerParticipant")
  interviewEvaluations InterviewEvaluation[] @relation("InterviewEvaluator")
  interviewFeedback InterviewFeedback[] @relation("InterviewFeedbackAuthor")
  submittedVerifications CompanyVerification[] @relation("VerificationSubmitter")
  reviewedVerifications CompanyVerification[] @relation("VerificationReviewer")
  changedStageHistory ApplicationStageHistory[] @relation("StageChangedBy")
  updatedAIConfigurations AIModelConfiguration[] @relation("AIConfigUpdater")
  decidedAppeals Appeal[] @relation("AppealDecider")
  recruiterInterviewsCreated RecruiterInterview[] @relation("RecruiterInterviewCreator")
  recruiterInterviewParticipants RecruiterInterviewParticipant[]
  interviewAvailabilities InterviewAvailability[]
  rescheduleRequestsCreated InterviewRescheduleRequest[] @relation("RescheduleRequester")
  rescheduleRequestsReviewed InterviewRescheduleRequest[] @relation("RescheduleReviewer")
  scorecardsSubmitted RecruiterScorecard[] @relation("ScorecardSubmitter")
  scorecardsFinalized RecruiterScorecard[] @relation("ScorecardFinalizer")
  scorecardCorrections RecruiterScorecardCorrection[]
  recruiterInterviewAudits RecruiterInterviewAudit[]
  liveRoomTokens LiveInterviewRoomToken[]
  liveRoomParticipants LiveInterviewParticipant[]
  @@index([role, status])
  @@index([status, createdAt])
}

model UserSession {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  sessionTokenHash   String   @unique @db.VarChar(255)
  ipAddress          String?  @db.VarChar(64)
  userAgent          String?  @db.VarChar(512)
  expiresAt          DateTime
  revokedAt          DateTime?
  revokeReason       String?
  createdAt          DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt, expiresAt])
}

model RefreshToken {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  tokenHash         String        @unique @db.VarChar(255)
  familyId          String        @db.Uuid
  replacedById      String?       @db.Uuid
  replacedBy        RefreshToken? @relation("RefreshTokenReplacedBy", fields: [replacedById], references: [id], onDelete: SetNull)
  replacedFrom      RefreshToken? @relation("RefreshTokenReplacedBy")
  expiresAt         DateTime
  revokedAt         DateTime?
  revokeReason      String?
  createdAt         DateTime      @default(now())
  user              User          @relation("RefreshTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, familyId, revokedAt])
  @@index([familyId, expiresAt])
  @@unique([replacedById])
}

model StudentProfile {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @unique @db.Uuid
  firstName         String        @db.VarChar(100)
  lastName          String        @db.VarChar(100)
  phone             String?       @db.VarChar(32)
  headline          String?       @db.VarChar(180)
  bio               String?
  location          String?       @db.VarChar(160)
  githubUrl         String?       @db.VarChar(500)
  linkedinUrl       String?       @db.VarChar(500)
  portfolioUrl      String?       @db.VarChar(500)
  discoverable      Boolean       @default(false)
  readinessScore    Decimal?      @db.Decimal(5, 2)
  readinessFormulaVersion String?
  readinessCalculatedAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  educations        Education[]
  skills            StudentSkill[]
  projects          Project[]
  experiences       Experience[]
  certifications    Certification[]
  resumes           Resume[]
  studyPlans        StudyPlan[]
  profileSuggestions ProfileSuggestion[]
  learningProgress  LearningProgress[]
  activities        StudentActivity[]
  @@index([discoverable, updatedAt])
}

model Education {
  id                String        @id @default(uuid()) @db.Uuid
  studentId         String        @db.Uuid
  institution       String        @db.VarChar(200)
  degree            String?       @db.VarChar(160)
  fieldOfStudy      String?       @db.VarChar(160)
  startDate         DateTime?
  endDate           DateTime?
  grade             Decimal?      @db.Decimal(5, 2)
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  @@index([studentId, endDate])
}

model Project {
  id                String        @id @default(uuid()) @db.Uuid
  studentId         String        @db.Uuid
  name              String        @db.VarChar(200)
  description       String?
  url               String?       @db.VarChar(500)
  repositoryUrl     String?       @db.VarChar(500)
  technologies      Json?
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  @@index([studentId, createdAt])
}

model Experience {
  id                String        @id @default(uuid()) @db.Uuid
  studentId         String        @db.Uuid
  organization      String        @db.VarChar(200)
  title             String        @db.VarChar(160)
  description       String?
  startDate         DateTime?
  endDate           DateTime?
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  @@index([studentId, endDate])
}

model Certification {
  id                String        @id @default(uuid()) @db.Uuid
  studentId         String        @db.Uuid
  name              String        @db.VarChar(200)
  issuer            String?       @db.VarChar(200)
  credentialUrl     String?       @db.VarChar(500)
  issuedAt          DateTime?
  expiresAt         DateTime?
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  @@index([studentId, expiresAt])
}

model Skill {
  id                String        @id @default(uuid()) @db.Uuid
  name              String        @unique @db.VarChar(120)
  category          String?       @db.VarChar(80)
  students          StudentSkill[]
  jobSkills         JobSkill[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model StudentSkill {
  id                String        @id @default(uuid()) @db.Uuid
  studentId         String        @db.Uuid
  skillId           String        @db.Uuid
  evidenceType      EvidenceType
  proficiency       Decimal?      @db.Decimal(5, 2)
  verifiedAt        DateTime?
  verifiedByUserId  String?       @db.Uuid
  sourceId          String?       @db.Uuid
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill             Skill         @relation(fields: [skillId], references: [id], onDelete: Restrict)
  verifiedBy        User?         @relation("SkillVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  @@index([studentId, skillId, evidenceType])
  @@index([skillId, evidenceType, verifiedAt])
  @@unique([studentId, skillId, evidenceType, sourceId])
}

model RecruiterProfile {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @unique @db.Uuid
  jobTitle          String?       @db.VarChar(160)
  department        String?       @db.VarChar(160)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Company {
  id                String        @id @default(uuid()) @db.Uuid
  name              String        @db.VarChar(200)
  website           String?       @db.VarChar(500)
  description       String?
  status            CompanyStatus @default(PENDING_VERIFICATION)
  members           CompanyMember[]
  jobs              Job[]
  verifications     CompanyVerification[]
  assessments       Assessment[]   @relation("CompanyAssessmentOwner")
  recruiterInterviews RecruiterInterview[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  @@index([status, name])
}

model CompanyMember {
  id                String            @id @default(uuid()) @db.Uuid
  companyId         String            @db.Uuid
  userId            String            @db.Uuid
  role              CompanyMemberRole
  active            Boolean           @default(true)
  invitedAt         DateTime          @default(now())
  acceptedAt        DateTime?
  deactivatedAt     DateTime?
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([companyId, userId])
  @@index([userId, active])
  @@index([companyId, role, active])
}

model CompanyVerification {
  id                String        @id @default(uuid()) @db.Uuid
  companyId         String        @db.Uuid
  submittedByUserId String        @db.Uuid
  reviewedByUserId  String?       @db.Uuid
  status            CompanyStatus
  evidenceFileId    String?       @db.Uuid
  note              String?
  submittedAt       DateTime      @default(now())
  reviewedAt        DateTime?
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  submittedBy       User          @relation("VerificationSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  reviewedBy        User?         @relation("VerificationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  evidenceFile      StoredFile?   @relation("VerificationEvidence", fields: [evidenceFileId], references: [id], onDelete: SetNull)
  @@index([companyId, status, submittedAt])
}

model Job {
  id                String          @id @default(uuid()) @db.Uuid
  companyId         String          @db.Uuid
  createdByUserId   String          @db.Uuid
  title             String          @db.VarChar(200)
  description       String
  location          String?         @db.VarChar(160)
  employmentType    EmploymentType
  salaryMin         Decimal?        @db.Decimal(12, 2)
  salaryMax         Decimal?        @db.Decimal(12, 2)
  educationRequirement String?
  experienceRequirement String?
  status            JobStatus       @default(DRAFT)
  deadline          DateTime?
  publishedAt       DateTime?
  closedAt          DateTime?
  metadata          Json?
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy         User            @relation("JobCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  skills            JobSkill[]
  applications      Application[]
  bookmarks         JobBookmark[]
  assessments       AssessmentAssignment[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  @@index([companyId, status, deadline])
  @@index([status, publishedAt])
}

model JobBookmark {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  jobId     String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@unique([userId, jobId])
  @@index([userId, createdAt])
}

model JobSkill {
  id                String        @id @default(uuid()) @db.Uuid
  jobId             String        @db.Uuid
  skillId           String        @db.Uuid
  required          Boolean       @default(true)
  job               Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill             Skill         @relation(fields: [skillId], references: [id], onDelete: Restrict)
  @@unique([jobId, skillId])
}

model Application {
  id                String            @id @default(uuid()) @db.Uuid
  jobId             String            @db.Uuid
  studentUserId     String            @db.Uuid
  reapplicationNumber Int             @default(1)
  resumeId          String?           @db.Uuid
  resumeVersionId   String?           @db.Uuid
  status            ApplicationStatus @default(APPLIED)
  consentSnapshot   Json
  appliedAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  job               Job               @relation(fields: [jobId], references: [id], onDelete: Restrict)
  student           User              @relation("ApplicationStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  resume            Resume?           @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  resumeVersion     ResumeVersion?    @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  stageHistory      ApplicationStageHistory[]
  notes             RecruiterNote[]
  assessmentAssignments AssessmentAssignment[]
  interviewSessions InterviewSession[]
  recruiterInterviews RecruiterInterview[]
  @@unique([jobId, studentUserId, reapplicationNumber])
  @@index([studentUserId, status, updatedAt])
  @@index([jobId, status, updatedAt])
}

model ApplicationStageHistory {
  id                String            @id @default(uuid()) @db.Uuid
  applicationId     String            @db.Uuid
  fromStatus        ApplicationStatus?
  toStatus          ApplicationStatus
  changedByUserId   String            @db.Uuid
  reason            String?
  createdAt         DateTime          @default(now())
  application       Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy         User              @relation("StageChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)
  @@index([applicationId, createdAt])
}

model RecruiterNote {
  id                String            @id @default(uuid()) @db.Uuid
  applicationId     String            @db.Uuid
  authorUserId      String            @db.Uuid
  body              String
  private           Boolean           @default(true)
  application       Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author            User              @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  @@index([applicationId, createdAt])
}

model StoredFile {
  id                String              @id @default(uuid()) @db.Uuid
  ownerUserId       String              @db.Uuid
  objectKey         String              @unique @db.VarChar(1000)
  originalName      String              @db.VarChar(255)
  mimeType          String              @db.VarChar(160)
  sizeBytes         Int
  sha256            String              @db.VarChar(64)
  scanStatus        FileScanStatus      @default(PENDING)
  retentionClass    FileRetentionClass
  deletedAt         DateTime?
  owner             User                @relation("FileOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  verificationEvidence CompanyVerification[] @relation("VerificationEvidence")
  resumeVersions    ResumeVersion[]
  moderationEvidence ModerationEvidence[]
  @@index([ownerUserId, scanStatus])
  @@index([retentionClass, deletedAt])
}

model Resume {
  id                String            @id @default(uuid()) @db.Uuid
  studentId         String            @db.Uuid
  title             String            @db.VarChar(200)
  visibility        String            @default("PRIVATE")
  activeVersionId   String?           @unique @db.Uuid
  deletedAt         DateTime?
  student           StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  activeVersion     ResumeVersion?   @relation("ResumeActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  versions          ResumeVersion[]  @relation("ResumeVersions")
  applications      Application[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  @@index([studentId, deletedAt])
}

model ResumeVersion {
  id                String            @id @default(uuid()) @db.Uuid
  resumeId          String            @db.Uuid
  fileId            String            @db.Uuid
  version           Int
  parsedText        String?
  parserVersion     String?
  createdByUserId   String            @db.Uuid
  resume            Resume            @relation("ResumeVersions", fields: [resumeId], references: [id], onDelete: Cascade)
  activeForResume   Resume?           @relation("ResumeActiveVersion")
  file              StoredFile        @relation(fields: [fileId], references: [id], onDelete: Restrict)
  applications      Application[]
  analyses          ResumeAnalysis[]
  processingJobs     ResumeProcessingJob[]
  @@unique([resumeId, version])
  @@index([fileId])
}

model ResumeProcessingJob {
  id              String   @id @default(uuid()) @db.Uuid
  resumeVersionId String   @db.Uuid
  status          String   @default("PENDING")
  attempts        Int      @default(0)
  errorMessage    String?
  queuedAt        DateTime @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  resumeVersion   ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)
  @@unique([resumeVersionId])
  @@index([status, queuedAt])
}

model ResumeAnalysis {
  id                String            @id @default(uuid()) @db.Uuid
  resumeVersionId   String            @db.Uuid
  targetRole        String            @db.VarChar(200)
  jobDescription    String?
  status            String
  modelAlias        String?
  promptVersion     String?
  score             Decimal?          @db.Decimal(5, 2)
  findings          Json
  usageRecordId     String?           @db.Uuid
  resumeVersion     ResumeVersion     @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)
  suggestions       ProfileSuggestion[]
  processingJob     ResumeAnalysisJob?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  @@index([resumeVersionId, createdAt])
}

model ResumeAnalysisJob {
  id            String         @id @default(uuid()) @db.Uuid
  analysisId    String         @unique @db.Uuid
  status        String         @default("PENDING")
  attempts      Int            @default(0)
  errorMessage  String?
  queuedAt      DateTime       @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  analysis      ResumeAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  @@index([status, queuedAt])
}

model ProfileSuggestion {
  id                String              @id @default(uuid()) @db.Uuid
  studentId         String              @db.Uuid
  resumeAnalysisId  String?             @db.Uuid
  fieldPath         String              @db.VarChar(255)
  currentValue      Json?
  suggestedValue    Json
  status            RecommendationStatus @default(PROPOSED)
  approvedAt        DateTime?
  student           StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  resumeAnalysis    ResumeAnalysis?     @relation(fields: [resumeAnalysisId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  @@index([studentId, status])
}

model CodingProblem {
  id                String          @id @default(uuid()) @db.Uuid
  slug              String          @unique @db.VarChar(180)
  title             String          @db.VarChar(240)
  statement         String
  inputFormat       String?
  outputFormat      String?
  constraints       Json?
  examples          Json?
  explanation       String?
  difficulty        String          @db.VarChar(32)
  starterCode       Json?
  timeLimitMs       Int             @default(2000)
  memoryLimitKb     Int             @default(262144)
  status            String          @default("DRAFT")
  topics            ProblemTopic[]
  testCases         TestCase[]
  languageConfigs   ProblemLanguageConfig[]
  submissions       CodeSubmission[]
  codeRuns          CodeRun[]
  progress          StudentProblemProgress[]
  bookmarks         Bookmark[]
  contestProblems    ContestProblem[]
  contestSubmissions ContestSubmission[]
  assessmentLinks AssessmentCodingProblem[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  @@index([status, difficulty])
}

model ProblemLanguageConfig {
  id                String         @id @default(uuid()) @db.Uuid
  problemId         String         @db.Uuid
  language          String         @db.VarChar(40)
  starterCode       String
  functionSignature String?
  enabled           Boolean        @default(true)
  problem           CodingProblem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  @@unique([problemId, language])
  @@index([language, enabled])
}

model ProblemTopic {
  problemId         String          @db.Uuid
  topicId           String          @db.Uuid
  problem           CodingProblem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  topic             Topic           @relation(fields: [topicId], references: [id], onDelete: Restrict)
  @@id([problemId, topicId])
}

model TestCase {
  id                String          @id @default(uuid()) @db.Uuid
  problemId         String          @db.Uuid
  kind              String          @db.VarChar(16)
  inputRef          String
  expectedOutputRef String
  sequence          Int
  enabled           Boolean         @default(true)
  problem           CodingProblem   @relation(fields: [problemId], references: [id], onDelete: Restrict)
  @@index([problemId, kind, sequence])
}

model CodeSubmission {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @db.Uuid
  problemId         String          @db.Uuid
  assignmentId      String?         @db.Uuid
  contestId         String?         @db.Uuid
  type              SubmissionType
  language          String          @db.VarChar(40)
  sourceCode        String
  sourceHash        String          @db.VarChar(64)
  idempotencyKey    String?         @db.VarChar(200)
  status            SubmissionStatus @default(RECEIVED)
  verdict           Verdict          @default(PENDING)
  policyVersion     String
  attemptCount      Int             @default(0)
  queuedAt          DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime        @default(now())
  user              User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  problem           CodingProblem   @relation(fields: [problemId], references: [id], onDelete: Restrict)
  assignment        AssessmentAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  contest           Contest?         @relation(fields: [contestId], references: [id], onDelete: SetNull)
  executionResults  ExecutionResult[]
  contestSubmission ContestSubmission?
  statusHistory     SubmissionStatusHistory[]
  codeRuns          CodeRun[]
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([problemId, status])
  @@index([status, queuedAt])
}

model CodeRun {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @db.Uuid
  problemId         String          @db.Uuid
  submissionId      String?         @db.Uuid
  language          String          @db.VarChar(40)
  sourceCode        String
  customInput       String?
  status            SubmissionStatus @default(RECEIVED)
  verdict           Verdict          @default(PENDING)
  provider          String?         @db.VarChar(80)
  executionTimeMs   Int?
  memoryKb          Int?
  stdout            String?
  stderr            String?
  compileOutput     String?
  createdAt         DateTime        @default(now())
  completedAt       DateTime?
  user              User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  problem           CodingProblem   @relation(fields: [problemId], references: [id], onDelete: Restrict)
  submission        CodeSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Contest {
  id                    String               @id @default(uuid()) @db.Uuid
  organizerUserId       String               @db.Uuid
  title                 String               @db.VarChar(240)
  slug                  String               @unique @db.VarChar(180)
  description           String?
  status                ContestStatus        @default(DRAFT)
  startsAt              DateTime
  endsAt                DateTime
  maxSubmissionsPerProblem Int               @default(3)
  allowedLanguages      Json?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  organizer             User                 @relation("ContestOrganizer", fields: [organizerUserId], references: [id], onDelete: Restrict)
  problems              ContestProblem[]
  registrations         ContestRegistration[]
  submissions           ContestSubmission[]
  codeSubmissions       CodeSubmission[]
  @@index([status, startsAt, endsAt])
  @@index([organizerUserId, createdAt])
}

model ContestProblem {
  id          String        @id @default(uuid()) @db.Uuid
  contestId   String        @db.Uuid
  problemId   String        @db.Uuid
  points      Int           @default(100)
  penaltyPerWrong Int       @default(0)
  sequence    Int           @default(1)
  contest     Contest       @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem     CodingProblem @relation(fields: [problemId], references: [id], onDelete: Restrict)
  @@unique([contestId, problemId])
  @@unique([contestId, sequence])
}

model ContestRegistration {
  id          String   @id @default(uuid()) @db.Uuid
  contestId   String   @db.Uuid
  userId      String   @db.Uuid
  registeredAt DateTime @default(now())
  contest     Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([contestId, userId])
  @@index([userId, registeredAt])
}

model ContestSubmission {
  id             String        @id @default(uuid()) @db.Uuid
  contestId      String        @db.Uuid
  userId         String        @db.Uuid
  problemId      String        @db.Uuid
  codeSubmissionId String      @unique @db.Uuid
  language       String        @db.VarChar(40)
  sourceHash     String        @db.VarChar(64)
  score          Int           @default(0)
  wrongAttempts  Int           @default(0)
  solved         Boolean       @default(false)
  submittedAt    DateTime      @default(now())
  contest        Contest       @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem        CodingProblem @relation(fields: [problemId], references: [id], onDelete: Restrict)
  codeSubmission CodeSubmission @relation(fields: [codeSubmissionId], references: [id], onDelete: Cascade)
  @@index([contestId, userId, submittedAt])
  @@unique([contestId, userId, problemId, submittedAt])
  @@unique([contestId, userId, problemId, sourceHash])
}

model SubmissionStatusHistory {
  id             String           @id @default(uuid()) @db.Uuid
  submissionId   String           @db.Uuid
  fromStatus     SubmissionStatus?
  toStatus       SubmissionStatus
  note           String?
  createdAt      DateTime         @default(now())
  submission     CodeSubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  @@index([submissionId, createdAt])
}

model StudentProblemProgress {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @db.Uuid
  problemId      String          @db.Uuid
  status         String          @default("UNSOLVED")
  attempts       Int             @default(0)
  solvedAt       DateTime?
  lastSubmittedAt DateTime?
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem        CodingProblem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  @@unique([userId, problemId])
  @@index([userId, status])
  @@index([problemId, status])
}

model ExecutionResult {
  id                String          @id @default(uuid()) @db.Uuid
  submissionId      String          @db.Uuid
  provider          String          @db.VarChar(80)
  providerRequestId String?
  passedTests       Int             @default(0)
  totalTests        Int             @default(0)
  executionTimeMs   Int?
  memoryKb          Int?
  stdout            String?
  stderr            String?
  compileOutput     String?
  failureCode       String?
  perTestSummary    Json?
  submission        CodeSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  @@index([submissionId, createdAt])
}

model Bookmark {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @db.Uuid
  problemId         String          @db.Uuid
  note              String?
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem           CodingProblem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  @@unique([userId, problemId])
}

model Assessment {
  id                String              @id @default(uuid()) @db.Uuid
  ownerCompanyId    String?             @db.Uuid
  createdByUserId   String              @db.Uuid
  title             String              @db.VarChar(240)
  type              AssessmentType
  status            AssessmentStatus    @default(DRAFT)
  durationSeconds   Int
  negativeMarking   Decimal             @default(0) @db.Decimal(5, 2)
  maxAttempts       Int                 @default(1)
  publishedAt       DateTime?
  ownerCompany      Company?            @relation("CompanyAssessmentOwner", fields: [ownerCompanyId], references: [id], onDelete: Restrict)
  createdBy          User                @relation("AssessmentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  questions         AssessmentQuestion[]
  codingProblems    AssessmentCodingProblem[]
  assignments        AssessmentAssignment[]
  reviews           AssessmentReview[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  @@index([ownerCompanyId, status])
  @@index([status, type])
}

model Question {
  id                String              @id @default(uuid()) @db.Uuid
  body              String
  type              String              @db.VarChar(40)
  difficulty        String              @db.VarChar(32)
  subjectId         String?             @db.Uuid
  topicId           String?             @db.Uuid
  answerKey         Json
  explanation       String?
  assessmentLinks   AssessmentQuestion[]
  options           QuestionOption[]
  subject           Subject?            @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic             Topic?              @relation(fields: [topicId], references: [id], onDelete: SetNull)
  answers            AssessmentAnswer[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  @@index([subjectId, topicId, difficulty])
}

model AssessmentQuestion {
  assessmentId      String              @db.Uuid
  questionId        String              @db.Uuid
  sequence          Int
  points            Decimal             @db.Decimal(8, 2)
  required          Boolean             @default(true)
  assessment        Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question          Question            @relation(fields: [questionId], references: [id], onDelete: Restrict)
  @@id([assessmentId, questionId])
  @@unique([assessmentId, sequence])
}

model AssessmentCodingProblem {
  assessmentId String        @db.Uuid
  problemId    String        @db.Uuid
  sequence     Int
  points       Decimal       @db.Decimal(8, 2)
  assessment   Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  problem      CodingProblem @relation(fields: [problemId], references: [id], onDelete: Restrict)
  @@id([assessmentId, problemId])
  @@unique([assessmentId, sequence])
}

model QuestionOption {
  id                String              @id @default(uuid()) @db.Uuid
  questionId        String              @db.Uuid
  label             String              @db.VarChar(20)
  value             String
  sequence          Int
  question          Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  @@unique([questionId, sequence])
}

model AssessmentAssignment {
  id                String              @id @default(uuid()) @db.Uuid
  assessmentId      String              @db.Uuid
  studentUserId     String              @db.Uuid
  assignedByUserId  String              @db.Uuid
  jobId             String?             @db.Uuid
  applicationId     String?             @db.Uuid
  startsAt          DateTime?
  dueAt             DateTime?
  status            AssignmentStatus    @default(ASSIGNED)
  invitedAt         DateTime             @default(now())
  completedAt       DateTime?
  assessment        Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  student           User                @relation("AssessmentStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  assignedBy        User                @relation("AssignmentAssigner", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  job               Job?                @relation(fields: [jobId], references: [id], onDelete: SetNull)
  application       Application?        @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  attempts          AssessmentAttempt[]
  submissions       CodeSubmission[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  @@index([studentUserId, status])
  @@index([applicationId])
}

model AssessmentReview {
  id          String            @id @default(uuid()) @db.Uuid
  assessmentId String           @db.Uuid
  attemptId   String            @db.Uuid
  reviewerId  String            @db.Uuid
  rating      Int?
  note        String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  assessment  Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  attempt     AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  reviewer    User              @relation("AssessmentReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  @@unique([assessmentId, attemptId])
  @@index([assessmentId, createdAt])
}

model AssessmentAttempt {
  id                String              @id @default(uuid()) @db.Uuid
  assignmentId      String              @db.Uuid
  userId            String              @db.Uuid
  attemptNumber     Int
  status            AttemptStatus       @default(NOT_STARTED)
  startedAt         DateTime?
  submittedAt       DateTime?
  expiresAt         DateTime?
  score             Decimal?            @db.Decimal(7, 2)
  assignment        AssessmentAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  user              User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  answers           AssessmentAnswer[]
  result            AssessmentResult?
  reviews           AssessmentReview[]
  @@unique([assignmentId, attemptNumber])
  @@index([userId, status])
}

model AssessmentAnswer {
  id                String              @id @default(uuid()) @db.Uuid
  attemptId         String              @db.Uuid
  questionId        String              @db.Uuid
  answer            Json
  isCorrect         Boolean?
  points             Decimal?           @db.Decimal(8, 2)
  answeredAt        DateTime            @default(now())
  attempt           AssessmentAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question          Question            @relation(fields: [questionId], references: [id], onDelete: Restrict)
  @@unique([attemptId, questionId])
}

model AssessmentResult {
  id                String              @id @default(uuid()) @db.Uuid
  attemptId         String              @unique @db.Uuid
  correctCount      Int                 @default(0)
  incorrectCount    Int                 @default(0)
  unattemptedCount  Int                 @default(0)
  topicBreakdown    Json
  gradedAt          DateTime            @default(now())
  attempt           AssessmentAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model Subject {
  id                String              @id @default(uuid()) @db.Uuid
  name              String              @db.VarChar(160)
  slug              String              @unique @db.VarChar(160)
  status            String              @default("PUBLISHED")
  topics            Topic[]
  questions         Question[]
  resources         LearningResource[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model Topic {
  id                String              @id @default(uuid()) @db.Uuid
  subjectId         String              @db.Uuid
  name              String              @db.VarChar(160)
  slug              String              @db.VarChar(160)
  subject           Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  subtopics         Subtopic[]
  questions         Question[]
  resources         LearningResource[]
  problemTopics     ProblemTopic[]
  progress          LearningProgress[]
  activities        StudentActivity[]
  tasks             StudyTask[]
  @@unique([subjectId, slug])
}

model Subtopic {
  id                String              @id @default(uuid()) @db.Uuid
  topicId           String              @db.Uuid
  name              String              @db.VarChar(160)
  slug              String              @db.VarChar(160)
  topic             Topic               @relation(fields: [topicId], references: [id], onDelete: Restrict)
  resources         LearningResource[]
  @@unique([topicId, slug])
}

model LearningResource {
  id                String              @id @default(uuid()) @db.Uuid
  subjectId         String?             @db.Uuid
  topicId           String?             @db.Uuid
  subtopicId        String?             @db.Uuid
  title             String              @db.VarChar(240)
  kind              String              @db.VarChar(40)
  uri               String
  status            String              @default("PUBLISHED")
  subject           Subject?            @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic             Topic?              @relation(fields: [topicId], references: [id], onDelete: SetNull)
  subtopic          Subtopic?           @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  progress          LearningProgress[]
  @@index([subjectId, topicId, subtopicId, status])
}

model LearningProgress {
  id                String              @id @default(uuid()) @db.Uuid
  studentProfileId  String              @db.Uuid
  resourceId        String?             @db.Uuid
  topicId           String?             @db.Uuid
  status            String
  percent           Decimal             @default(0) @db.Decimal(5, 2)
  lastActivityAt    DateTime            @default(now())
  student           StudentProfile     @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  resource          LearningResource?   @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  topic             Topic?              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  @@unique([studentProfileId, resourceId, topicId])
  @@index([studentProfileId, lastActivityAt])
}

model StudentActivity {
  id                String              @id @default(uuid()) @db.Uuid
  studentProfileId  String              @db.Uuid
  activityType      String              @db.VarChar(80)
  topicId           String?             @db.Uuid
  sourceId          String?             @db.Uuid
  occurredAt        DateTime            @default(now())
  durationSeconds   Int?
  metadata          Json?
  student           StudentProfile     @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  topic             Topic?              @relation(fields: [topicId], references: [id], onDelete: SetNull)
  @@index([studentProfileId, occurredAt])
  @@index([topicId, occurredAt])
}

model StudyPlan {
  id                String              @id @default(uuid()) @db.Uuid
  studentProfileId  String              @db.Uuid
  targetRole        String?
  targetCompanies   Json?
  deadline          DateTime?
  dailyMinutes      Int?
  status            String              @default("ACTIVE")
  student           StudentProfile     @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  goals             StudyGoal[]
  tasks             StudyTask[]
  recommendations   StudyRecommendation[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  @@index([studentProfileId, status])
}

model StudyGoal {
  id                String              @id @default(uuid()) @db.Uuid
  studyPlanId       String              @db.Uuid
  title             String              @db.VarChar(240)
  priority          String              @db.VarChar(32)
  targetDate        DateTime?
  status            String
  plan              StudyPlan           @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  tasks             StudyTask[]
  @@index([studyPlanId, status])
}

model StudyTask {
  id                String              @id @default(uuid()) @db.Uuid
  studyPlanId       String              @db.Uuid
  goalId            String?             @db.Uuid
  topicId           String?             @db.Uuid
  title             String              @db.VarChar(240)
  dueAt             DateTime?
  priority          String              @db.VarChar(32)
  status            String
  source            String
  plan              StudyPlan           @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  goal              StudyGoal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)
  topic             Topic?              @relation(fields: [topicId], references: [id], onDelete: SetNull)
  completions       StudyTaskCompletion[]
  @@index([studyPlanId, dueAt, status])
}

model StudyTaskCompletion {
  id                String              @id @default(uuid()) @db.Uuid
  taskId            String              @db.Uuid
  completedByUserId String              @db.Uuid
  completedAt       DateTime            @default(now())
  evidence          Json?
  task              StudyTask           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedBy       User                @relation(fields: [completedByUserId], references: [id], onDelete: Restrict)
  @@unique([taskId, completedByUserId])
}

model StudyRecommendation {
  id                String              @id @default(uuid()) @db.Uuid
  studyPlanId       String              @db.Uuid
  inputs            Json
  proposedChanges   Json
  status            RecommendationStatus @default(PROPOSED)
  approvedAt        DateTime?
  plan              StudyPlan           @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  @@index([studyPlanId, status])
}

model RecruiterInterview {
  id                 String                   @id @default(uuid()) @db.Uuid
  companyId          String                   @db.Uuid
  applicationId      String                   @db.Uuid
  createdByUserId    String                   @db.Uuid
  title              String                   @db.VarChar(240)
  status             RecruiterInterviewStatus @default(DRAFT)
  timezone           String                   @db.VarChar(80)
  scheduledStart     DateTime?
  scheduledEnd       DateTime?
  meetingUrl         String?                  @db.VarChar(1000)
  cancellationReason String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  company            Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  application        Application              @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  createdBy          User                     @relation("RecruiterInterviewCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  rounds             RecruiterInterviewRound[]
  participants       RecruiterInterviewParticipant[]
  rescheduleRequests InterviewRescheduleRequest[]
  scorecards         RecruiterScorecard[]
  auditEvents        RecruiterInterviewAudit[]
  liveRoom           LiveInterviewRoom?
  @@index([companyId, status, scheduledStart])
  @@index([applicationId, status])
}

model LiveInterviewRoom {
  id              String                    @id @default(uuid()) @db.Uuid
  interviewId     String                    @unique @db.Uuid
  status          LiveRoomStatus            @default(WAITING)
  expiresAt       DateTime
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  interview       RecruiterInterview        @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  participants    LiveInterviewParticipant[]
  tokens          LiveInterviewRoomToken[]
  @@index([status, expiresAt])
}

model LiveInterviewRoomToken {
  id          String           @id @default(uuid()) @db.Uuid
  roomId      String           @db.Uuid
  userId      String           @db.Uuid
  tokenHash   String           @unique @db.VarChar(128)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())
  room        LiveInterviewRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([roomId, userId, expiresAt])
}

model LiveInterviewParticipant {
  id          String           @id @default(uuid()) @db.Uuid
  roomId      String           @db.Uuid
  userId      String           @db.Uuid
  role        InterviewParticipantRole
  socketId    String?          @db.VarChar(120)
  joinedAt    DateTime?
  leftAt      DateTime?
  createdAt   DateTime         @default(now())
  room        LiveInterviewRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([roomId, userId])
  @@index([roomId, leftAt])
}

model RecruiterInterviewRound {
  id          String                   @id @default(uuid()) @db.Uuid
  interviewId String                   @db.Uuid
  sequence    Int
  name        String                   @db.VarChar(160)
  status      RecruiterRoundStatus     @default(PLANNED)
  startsAt    DateTime?
  endsAt      DateTime?
  interview   RecruiterInterview        @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  participants RecruiterInterviewParticipant[]
  scorecards  RecruiterScorecard[]
  @@unique([interviewId, sequence])
  @@index([interviewId, status])
}

model RecruiterInterviewParticipant {
  id          String                   @id @default(uuid()) @db.Uuid
  interviewId String                   @db.Uuid
  roundId     String?                  @db.Uuid
  userId      String                   @db.Uuid
  role        InterviewParticipantRole
  confirmedAt DateTime?
  createdAt   DateTime                 @default(now())
  interview   RecruiterInterview        @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  round       RecruiterInterviewRound?  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user        User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([interviewId, userId])
  @@index([userId, role])
}

model InterviewAvailability {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  timezone  String   @db.VarChar(80)
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, startsAt, endsAt])
}

model InterviewRescheduleRequest {
  id             String                  @id @default(uuid()) @db.Uuid
  interviewId    String                  @db.Uuid
  requestedById  String                  @db.Uuid
  proposedStart  DateTime
  proposedEnd    DateTime
  timezone       String                  @db.VarChar(80)
  reason         String?
  status         RescheduleRequestStatus @default(PENDING)
  reviewedById   String?                 @db.Uuid
  reviewedAt     DateTime?
  createdAt      DateTime                @default(now())
  interview      RecruiterInterview      @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  requestedBy    User                    @relation("RescheduleRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy     User?                   @relation("RescheduleReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  @@index([interviewId, status, createdAt])
}

model RecruiterScorecard {
  id            String          @id @default(uuid()) @db.Uuid
  interviewId   String          @db.Uuid
  roundId       String?         @db.Uuid
  evaluatorId   String          @db.Uuid
  status        ScorecardStatus @default(DRAFT)
  ratings       Json
  overallScore  Decimal?        @db.Decimal(5, 2)
  recommendation String?
  comments      String?
  submittedAt   DateTime?
  finalizedAt   DateTime?
  finalizedById String?         @db.Uuid
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  interview     RecruiterInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  round         RecruiterInterviewRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)
  evaluator     User            @relation("ScorecardSubmitter", fields: [evaluatorId], references: [id], onDelete: Restrict)
  finalizedBy   User?           @relation("ScorecardFinalizer", fields: [finalizedById], references: [id], onDelete: SetNull)
  corrections   RecruiterScorecardCorrection[]
  @@unique([interviewId, roundId, evaluatorId])
  @@index([interviewId, status])
}

model RecruiterScorecardCorrection {
  id          String             @id @default(uuid()) @db.Uuid
  scorecardId String             @db.Uuid
  correctedById String           @db.Uuid
  previous    Json
  corrected   Json
  reason      String
  createdAt   DateTime           @default(now())
  scorecard   RecruiterScorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  correctedBy User               @relation(fields: [correctedById], references: [id], onDelete: Restrict)
  @@index([scorecardId, createdAt])
}

model RecruiterInterviewAudit {
  id          String            @id @default(uuid()) @db.Uuid
  interviewId String            @db.Uuid
  actorId     String            @db.Uuid
  action      String            @db.VarChar(80)
  details     Json?
  createdAt   DateTime          @default(now())
  interview   RecruiterInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  actor       User              @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([interviewId, createdAt])
}

model InterviewSession {
  id                String              @id @default(uuid()) @db.Uuid
  type              InterviewType
  status            InterviewStatus     @default(DRAFT)
  createdByUserId   String              @db.Uuid
  applicationId     String?             @db.Uuid
  configuration     Json
  rubricVersion     String
  currentSequence   Int                 @default(0)
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  consentSnapshot   Json
  createdBy         User                @relation("InterviewCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  application       Application?        @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  participants      InterviewParticipant[]
  questions         InterviewQuestion[]
  evaluations       InterviewEvaluation[]
  feedback          InterviewFeedback[]
  @@index([status, scheduledAt])
  @@index([applicationId])
}

model InterviewParticipant {
  id                String              @id @default(uuid()) @db.Uuid
  sessionId         String              @db.Uuid
  userId            String              @db.Uuid
  role              String              @db.VarChar(40)
  joinedAt          DateTime?
  leftAt            DateTime?
  session           InterviewSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user              User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([sessionId, userId])
}

model InterviewQuestion {
  id                String              @id @default(uuid()) @db.Uuid
  sessionId         String              @db.Uuid
  sequence          Int
  text              String
  topic             String?
  generatedBy       String
  promptVersion     String?
  session           InterviewSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers           InterviewAnswer[]
  @@unique([sessionId, sequence])
}

model InterviewAnswer {
  id                String              @id @default(uuid()) @db.Uuid
  questionId        String              @db.Uuid
  participantUserId String              @db.Uuid
  text              String
  submittedAt       DateTime            @default(now())
  durationSeconds   Int?
  question          InterviewQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  participant       User                @relation("InterviewAnswerParticipant", fields: [participantUserId], references: [id], onDelete: Restrict)
  @@index([questionId, submittedAt])
}

model InterviewEvaluation {
  id                String              @id @default(uuid()) @db.Uuid
  sessionId         String              @db.Uuid
  evaluatorUserId   String?             @db.Uuid
  modelAlias        String?
  rubricVersion     String
  categoryScores    Json
  overallScore      Decimal?            @db.Decimal(5, 2)
  evidence          Json
  status            String
  session           InterviewSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  evaluator         User?               @relation("InterviewEvaluator", fields: [evaluatorUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  @@index([sessionId, createdAt])
}

model InterviewFeedback {
  id                String              @id @default(uuid()) @db.Uuid
  sessionId         String              @db.Uuid
  authorUserId      String              @db.Uuid
  audience          String
  body              String
  visibleAt         DateTime?
  session           InterviewSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author            User                @relation("InterviewFeedbackAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  @@index([sessionId, audience])
}

model AIConversation {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @db.Uuid
  subject           String?
  topic             String?
  status            String              @default("ACTIVE")
  lastMessageAt     DateTime?
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages          AIMessage[]
  @@index([userId, lastMessageAt])
}

model AIMessage {
  id                String              @id @default(uuid()) @db.Uuid
  conversationId    String              @db.Uuid
  role              AIMessageRole
  content           String
  promptVersion     String?
  modelAlias        String?
  status            AIMessageStatus      @default(COMPLETE)
  requestId         String?
  createdAt         DateTime            @default(now())
  conversation      AIConversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model AIUsageRecord {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @db.Uuid
  feature           String
  provider          String
  modelAlias        String
  promptVersion     String
  providerRequestId  String?
  requestId         String              @unique
  inputTokens       Int                 @default(0)
  outputTokens      Int                 @default(0)
  cachedTokens      Int                 @default(0)
  estimatedCost     Decimal?            @db.Decimal(12, 6)
  actualCost        Decimal?            @db.Decimal(12, 6)
  pricingVersion     String?
  status            AIRequestStatus     @default(QUEUED)
  user              User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt         DateTime            @default(now())
  @@index([userId, createdAt])
  @@index([feature, createdAt])
}

model AIModelConfiguration {
  id                String              @id @default(uuid()) @db.Uuid
  modelAlias        String              @unique
  provider          String
  secretRef         String
  active            Boolean             @default(false)
  maxInputTokens    Int
  maxOutputTokens   Int
  pricingVersion    String
  costPolicy        Json
  updatedByUserId   String              @db.Uuid
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  updatedBy         User                @relation("AIConfigUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
}

model AIEvaluation {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @db.Uuid
  feature           String
  sourceId          String              @db.Uuid
  rubricVersion     String
  scores            Json
  evidence          Json
  status            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt         DateTime            @default(now())
  @@index([userId, feature, createdAt])
}

model AnalyticsSnapshot {
  id                String              @id @default(uuid()) @db.Uuid
  subjectType       String
  subjectId         String              @db.Uuid
  metricName        String
  value             Decimal?            @db.Decimal(7, 2)
  sampleCount       Int                 @default(0)
  formulaVersion    String
  periodStart       DateTime
  periodEnd         DateTime
  createdAt         DateTime            @default(now())
  @@unique([subjectType, subjectId, metricName, formulaVersion, periodStart, periodEnd])
  @@index([subjectType, subjectId, periodEnd])
}

model Notification {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @db.Uuid
  type              NotificationType
  title             String              @db.VarChar(240)
  body              String
  resourceType      String?
  resourceId        String?             @db.Uuid
  readAt            DateTime?
  expiresAt         DateTime?
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime            @default(now())
  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @unique @db.Uuid
  inApp             Boolean             @default(true)
  email             Boolean             @default(true)
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConsentRecord {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @db.Uuid
  type              ConsentType
  status            ConsentStatus
  scope             Json
  policyVersion     String
  grantedAt         DateTime?
  revokedAt         DateTime?
  expiresAt         DateTime?
  source            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt         DateTime            @default(now())
  @@index([userId, type, status])
}

model DataAccessLog {
  id                String              @id @default(uuid()) @db.Uuid
  actorUserId       String              @db.Uuid
  subjectUserId     String?             @db.Uuid
  resourceType      String
  resourceId        String?             @db.Uuid
  action            String
  purpose           String
  decision          String
  requestId         String
  ipAddress         String?
  actor             User                @relation("DataAccessActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  subject           User?               @relation("DataAccessSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  @@index([subjectUserId, createdAt])
  @@index([actorUserId, createdAt])
}

model AuditLog {
  id                String              @id @default(uuid()) @db.Uuid
  actorUserId       String?             @db.Uuid
  action            String
  resourceType      String
  resourceId        String?             @db.Uuid
  before            Json?
  after             Json?
  requestId         String
  ipAddress         String?
  createdByUserId   String?             @db.Uuid
  actor             User?               @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  createdBy         User?               @relation("AuditCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  @@index([resourceType, resourceId, createdAt])
  @@index([actorUserId, createdAt])
}

model SecurityEvent {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String?             @db.Uuid
  type              String
  severity          String
  source            String
  details           Json
  status            String
  resolvedByUserId  String?             @db.Uuid
  resolvedAt        DateTime?
  user              User?               @relation("SecuritySubject", fields: [userId], references: [id], onDelete: SetNull)
  resolvedBy        User?               @relation("SecurityResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  @@index([severity, status, createdAt])
  @@index([userId, createdAt])
}

model ModerationCase {
  id                String              @id @default(uuid()) @db.Uuid
  subjectUserId     String              @db.Uuid
  reportedByUserId  String?             @db.Uuid
  status            ModerationStatus
  category          String
  summary           String
  decision          Json?
  decidedByUserId   String?             @db.Uuid
  appealDueAt       DateTime?
  subject           User                @relation("ModerationSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  reportedBy        User?               @relation("ModerationReporter", fields: [reportedByUserId], references: [id], onDelete: SetNull)
  decidedBy         User?               @relation("ModerationDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  evidence          ModerationEvidence[]
  actions           ModerationAction[]
  appeals           Appeal[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  @@index([subjectUserId, status])
  @@index([status, createdAt])
}

model ModerationEvidence {
  id                String              @id @default(uuid()) @db.Uuid
  caseId            String              @db.Uuid
  fileId            String?             @db.Uuid
  sourceType        String
  sourceId          String?             @db.Uuid
  description       String
  sha256            String?
  case              ModerationCase      @relation(fields: [caseId], references: [id], onDelete: Restrict)
  file              StoredFile?         @relation(fields: [fileId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  @@index([caseId, createdAt])
}

model ModerationAction {
  id                String              @id @default(uuid()) @db.Uuid
  caseId            String              @db.Uuid
  actorUserId       String              @db.Uuid
  action            String
  reason            String
  startsAt          DateTime
  endsAt            DateTime?
  case              ModerationCase      @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actor             User                @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime            @default(now())
  @@index([caseId, createdAt])
}

model Appeal {
  id                String              @id @default(uuid()) @db.Uuid
  caseId            String              @db.Uuid
  submittedByUserId String              @db.Uuid
  body              String
  status            String
  decidedByUserId   String?             @db.Uuid
  decidedAt         DateTime?
  case              ModerationCase      @relation(fields: [caseId], references: [id], onDelete: Restrict)
  submittedBy       User                @relation(fields: [submittedByUserId], references: [id], onDelete: Restrict)
  decidedBy         User?               @relation("AppealDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  @@index([caseId, status])
}
