  round       RecruiterInterviewRound?  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user        User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([interviewId, userId])
  @@index([userId, role])
}

model InterviewAvailability {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  timezone  String   @db.VarChar(80)
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, startsAt, endsAt])
}

model InterviewRescheduleRequest {
  id             String                  @id @default(uuid()) @db.Uuid
  interviewId    String                  @db.Uuid
  requestedById  String                  @db.Uuid
  proposedStart  DateTime
  proposedEnd    DateTime
  timezone       String                  @db.VarChar(80)
  reason         String?
  status         RescheduleRequestStatus @default(PENDING)
  reviewedById   String?                 @db.Uuid
  reviewedAt     DateTime?
  createdAt      DateTime                @default(now())
  interview      RecruiterInterview      @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  requestedBy    User                    @relation("RescheduleRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy     User?                   @relation("RescheduleReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  @@index([interviewId, status, createdAt])
}

model RecruiterScorecard {
  id            String          @id @default(uuid()) @db.Uuid
  interviewId   String          @db.Uuid
  roundId       String?         @db.Uuid
  evaluatorId   String          @db.Uuid
  status        ScorecardStatus @default(DRAFT)
  ratings       Json
  overallScore  Decimal?        @db.Decimal(5, 2)
  recommendation String?
  comments      String?
  submittedAt   DateTime?
  finalizedAt   DateTime?
  finalizedById String?         @db.Uuid
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  interview     RecruiterInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  round         RecruiterInterviewRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)
  evaluator     User            @relation("ScorecardSubmitter", fields: [evaluatorId], references: [id], onDelete: Restrict)
  finalizedBy   User?           @relation("ScorecardFinalizer", fields: [finalizedById], references: [id], onDelete: SetNull)
  corrections   RecruiterScorecardCorrection[]
  @@unique([interviewId, roundId, evaluatorId])
  @@index([interviewId, status])
}

model RecruiterScorecardCorrection {
  id          String             @id @default(uuid()) @db.Uuid
  scorecardId String             @db.Uuid
  correctedById String           @db.Uuid
  previous    Json
  corrected   Json
  reason      String
  createdAt   DateTime           @default(now())
  scorecard   RecruiterScorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  correctedBy User               @relation(fields: [correctedById], references: [id], onDelete: Restrict)
  @@index([scorecardId, createdAt])
}

model RecruiterInterviewAudit {
  id          String            @id @default(uuid()) @db.Uuid
  interviewId String            @db.Uuid
  actorId     String            @db.Uuid
  action      String            @db.VarChar(80)
  details     Json?
  createdAt   DateTime          @default(now())
  interview   RecruiterInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  actor       User              @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([interviewId, createdAt])
}

model Offer {
  id                String      @id @default(uuid()) @db.Uuid
  applicationId     String      @db.Uuid
  jobId             String      @db.Uuid
  studentUserId     String      @db.Uuid
  createdByUserId   String      @db.Uuid
  designation       String      @db.VarChar(200)
  compensation      Json
  joiningDate       DateTime
  expiresAt         DateTime
  status            OfferStatus @default(DRAFT)
  responseReason    String?
  sentAt            DateTime?
  respondedAt       DateTime?
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  job               Job         @relation(fields: [jobId], references: [id], onDelete: Restrict)
  student           User        @relation("OfferStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  createdBy         User        @relation("OfferCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  @@index([applicationId, status])
  @@index([studentUserId, status])
  @@index([jobId, status])
  @@index([jobId, status, expiresAt])
  @@index([jobId, respondedAt])
}

model InterviewSession {
  id                String              @id @default(uuid()) @db.Uuid
  type              InterviewType
  status            InterviewStatus     @default(DRAFT)
  createdByUserId   String              @db.Uuid
  applicationId     String?             @db.Uuid
  configuration     Json
  rubricVersion     String
  currentSequence   Int                 @default(0)
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  consentSnapshot   Json
  createdBy         User                @relation("InterviewCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  application       Application?        @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  participants      InterviewParticipant[]
  questions         InterviewQuestion[]
  evaluations       InterviewEvaluation[]
  feedback          InterviewFeedback[]
  @@index([status, scheduledAt])
  @@index([applicationId])
}

model InterviewParticipant {
  id                String              @id @default(uuid()) @db.Uuid
  sessionId         String              @db.Uuid
  userId            String              @db.Uuid
  role              String              @db.VarChar(40)
  joinedAt          DateTime?
  leftAt            DateTime?
  session           InterviewSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user              User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([sessionId, userId])
}

model InterviewQuestion {
  id                String              @id @default(uuid()) @db.Uuid
  sessionId         String              @db.Uuid
  sequence          Int
  text              String
  topic             String?
  generatedBy       String
  promptVersion     String?
  session           InterviewSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers           InterviewAnswer[]
  evaluations       InterviewEvaluation[]
  @@unique([sessionId, sequence])
}

model InterviewAnswer {
  id                String              @id @default(uuid()) @db.Uuid
  questionId        String              @db.Uuid
  participantUserId String              @db.Uuid
  text              String
  submittedAt       DateTime            @default(now())
  durationSeconds   Int?
  question          InterviewQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  participant       User                @relation("InterviewAnswerParticipant", fields: [participantUserId], references: [id], onDelete: Restrict)
  @@index([questionId, submittedAt])
  @@unique([questionId, participantUserId])
}

model InterviewEvaluation {
  id                String              @id @default(uuid()) @db.Uuid
  sessionId         String              @db.Uuid
  questionId        String?             @unique @db.Uuid
  evaluatorUserId   String?             @db.Uuid
  modelAlias        String?
  rubricVersion     String
  categoryScores    Json
  overallScore      Decimal?            @db.Decimal(5, 2)
  evidence          Json
  status            String
  session           InterviewSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question          InterviewQuestion?  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  evaluator         User?               @relation("InterviewEvaluator", fields: [evaluatorUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  @@index([sessionId, createdAt])
}

model InterviewFeedback {
  id                String              @id @default(uuid()) @db.Uuid
  sessionId         String              @db.Uuid
  authorUserId      String              @db.Uuid
  audience          String
  body              String
  visibleAt         DateTime?
  session           InterviewSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author            User                @relation("InterviewFeedbackAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  @@index([sessionId, audience])
}

model AIUsageRecord {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @db.Uuid
  feature           String
  provider          String
  modelAlias        String
  promptVersion     String
  providerRequestId  String?
  requestId         String              @unique
  inputTokens       Int                 @default(0)
  outputTokens      Int                 @default(0)
  cachedTokens      Int                 @default(0)
  estimatedCost     Decimal?            @db.Decimal(12, 6)
  actualCost        Decimal?            @db.Decimal(12, 6)
  pricingVersion     String?
  status            AIRequestStatus     @default(QUEUED)
  user              User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt         DateTime            @default(now())
  @@index([userId, createdAt])
  @@index([feature, createdAt])
}

model AIModelConfiguration {
  id                String              @id @default(uuid()) @db.Uuid
  modelAlias        String              @unique
  provider          String
  secretRef         String
  active            Boolean             @default(false)
  maxInputTokens    Int
  maxOutputTokens   Int
  pricingVersion    String
  costPolicy        Json
  updatedByUserId   String              @db.Uuid
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  updatedBy         User                @relation("AIConfigUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
}

model AIEvaluation {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @db.Uuid
  feature           String
  sourceId          String              @db.Uuid
  rubricVersion     String
  scores            Json
  evidence          Json
  status            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt         DateTime            @default(now())
  @@index([userId, feature, createdAt])
}

model AnalyticsSnapshot {
  id                String              @id @default(uuid()) @db.Uuid
  subjectType       String
  subjectId         String              @db.Uuid
  metricName        String
  value             Decimal?            @db.Decimal(7, 2)
  sampleCount       Int                 @default(0)
  formulaVersion    String
  periodStart       DateTime
  periodEnd         DateTime
  createdAt         DateTime            @default(now())
  @@unique([subjectType, subjectId, metricName, formulaVersion, periodStart, periodEnd])
  @@index([subjectType, subjectId, periodEnd])
}

model Notification {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @db.Uuid
  type              NotificationType
  title             String              @db.VarChar(240)
  body              String
  resourceType      String?
  resourceId        String?             @db.Uuid
  readAt            DateTime?
  expiresAt         DateTime?
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime            @default(now())
  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @unique @db.Uuid
  inApp             Boolean             @default(true)
  email             Boolean             @default(true)
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConsentRecord {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @db.Uuid
  type              ConsentType
  status            ConsentStatus
  scope             Json
  policyVersion     String
  grantedAt         DateTime?
  revokedAt         DateTime?
  expiresAt         DateTime?
  source            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt         DateTime            @default(now())
  @@index([userId, type, status])
}

model DataAccessLog {
  id                String              @id @default(uuid()) @db.Uuid
  actorUserId       String              @db.Uuid
  subjectUserId     String?             @db.Uuid
  resourceType      String
  resourceId        String?             @db.Uuid
  action            String
  purpose           String
  decision          String
  requestId         String
  ipAddress         String?
  actor             User                @relation("DataAccessActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  subject           User?               @relation("DataAccessSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  @@index([subjectUserId, createdAt])
  @@index([actorUserId, createdAt])
}

model AuditLog {
  id                String              @id @default(uuid()) @db.Uuid
  actorUserId       String?             @db.Uuid
  action            String
  resourceType      String
  resourceId        String?             @db.Uuid
  before            Json?
  after             Json?
  requestId         String
  ipAddress         String?
  createdByUserId   String?             @db.Uuid
  actor             User?               @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  createdBy         User?               @relation("AuditCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  @@index([resourceType, resourceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model SecurityEvent {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String?             @db.Uuid
  type              String
  severity          String
  source            String
  details           Json
  status            String
  resolvedByUserId  String?             @db.Uuid
  resolvedAt        DateTime?
  user              User?               @relation("SecuritySubject", fields: [userId], references: [id], onDelete: SetNull)
  resolvedBy        User?               @relation("SecurityResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  @@index([severity, status, createdAt])
  @@index([userId, createdAt])
}

model ModerationCase {
  id                String              @id @default(uuid()) @db.Uuid
  subjectUserId     String              @db.Uuid
  reportedByUserId  String?             @db.Uuid
  status            ModerationStatus
  category          String
  summary           String
  decision          Json?
  decidedByUserId   String?             @db.Uuid
  appealDueAt       DateTime?
  subject           User                @relation("ModerationSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  reportedBy        User?               @relation("ModerationReporter", fields: [reportedByUserId], references: [id], onDelete: SetNull)
  decidedBy         User?               @relation("ModerationDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  evidence          ModerationEvidence[]
  actions           ModerationAction[]
  appeals           Appeal[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  @@index([subjectUserId, status])
  @@index([status, createdAt])
}

model ModerationEvidence {
  id                String              @id @default(uuid()) @db.Uuid
  caseId            String              @db.Uuid
  fileId            String?             @db.Uuid
  sourceType        String
  sourceId          String?             @db.Uuid
  description       String
  sha256            String?
  case              ModerationCase      @relation(fields: [caseId], references: [id], onDelete: Restrict)
  file              StoredFile?         @relation(fields: [fileId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  @@index([caseId, createdAt])
}

model ModerationAction {
  id                String              @id @default(uuid()) @db.Uuid
  caseId            String              @db.Uuid
  actorUserId       String              @db.Uuid
  action            String
  reason            String
  startsAt          DateTime
  endsAt            DateTime?
  case              ModerationCase      @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actor             User                @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime            @default(now())
  @@index([caseId, createdAt])
}

model Appeal {
  id                String              @id @default(uuid()) @db.Uuid
  caseId            String              @db.Uuid
  submittedByUserId String              @db.Uuid
  body              String
  status            String
  decidedByUserId   String?             @db.Uuid
  decidedAt         DateTime?
  case              ModerationCase      @relation(fields: [caseId], references: [id], onDelete: Restrict)
  submittedBy       User                @relation(fields: [submittedByUserId], references: [id], onDelete: Restrict)
  decidedBy         User?               @relation("AppealDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  @@index([caseId, status])
}

// ─── Phase 22: DSA Sheets ─────────────────────────────────────────────────────

model DSASheet {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @db.VarChar(200)
  slug        String          @unique @db.VarChar(200)
  author      String?         @db.VarChar(200)
  description String?
  status      String          @default("PUBLISHED")
  problems    DSASheetProblem[]
  progress    DSASheetProgress[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model DSASheetProblem {
  id          String        @id @default(uuid()) @db.Uuid
  sheetId     String        @db.Uuid
  problemId   String?       @db.Uuid
  externalUrl String?       @db.VarChar(1000)
  title       String        @db.VarChar(240)
  difficulty  String?       @db.VarChar(32)
  topic       String?       @db.VarChar(160)
  platform    String?       @db.VarChar(80)
  sequence    Int           @default(0)
  sheet       DSASheet      @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  problem     CodingProblem? @relation(fields: [problemId], references: [id], onDelete: SetNull)
  progress    DSASheetProgress[]
  @@index([sheetId, sequence])
}

model DSASheetProgress {
  id              String         @id @default(uuid()) @db.Uuid
  sheetId         String         @db.Uuid
  sheetProblemId  String         @db.Uuid
  userId          String         @db.Uuid
  status          String         @default("UNSOLVED")
  solvedAt        DateTime?
  notes           String?
  sheet           DSASheet       @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  sheetProblem    DSASheetProblem @relation(fields: [sheetProblemId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([sheetProblemId, userId])
  @@index([sheetId, userId])
}

// ─── Phase 23: Target Roles ───────────────────────────────────────────────────

model TargetRole {
  id              String        @id @default(uuid()) @db.Uuid
  name            String        @unique @db.VarChar(200)
  slug            String        @unique @db.VarChar(200)
  description     String?
  requiredSkills  Json          @default("[]")
  dsaRequirements Json          @default("{}")
  coreSubjects    Json          @default("[]")
  languages       Json          @default("[]")
  status          String        @default("PUBLISHED")
  studentRoles    StudentTargetRole[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model StudentTargetRole {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  roleId       String     @db.Uuid
  isPrimary    Boolean    @default(false)
  goalDate     DateTime?
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         TargetRole @relation(fields: [roleId], references: [id], onDelete: Restrict)
  @@unique([userId, roleId])
  @@index([userId, isPrimary])
}

// ─── Phase 27: Integrity Events ───────────────────────────────────────────────

model IntegrityEvent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  sessionId   String?  @db.VarChar(200)
  sessionType String   @db.VarChar(80)
  eventType   String   @db.VarChar(80)
  severity    String   @db.VarChar(32)
  metadata    Json?
  reviewStatus String  @default("PENDING")
  reviewNote  String?
  reviewedAt  DateTime?
  reviewedByUserId String? @db.Uuid
  occurredAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, occurredAt])
  @@index([sessionType, sessionId, occurredAt])
  @@index([severity, reviewStatus])
}
