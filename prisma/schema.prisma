generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  RECRUITER
  ADMIN
  SYSTEM
}

enum OAuthProvider {
  GOOGLE
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum CompanyStatus {
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
  REJECTED
}

enum CompanyMemberRole {
  OWNER
  HIRING_MANAGER
  REVIEWER
  INTERVIEWER
  ANALYST
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  SHORTLISTED
  TECHNICAL_INTERVIEW
  HR_INTERVIEW
  SELECTED
  OFFER_RELEASED
  HIRED
  REJECTED
  WITHDRAWN
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum EvidenceType {
  SELF_DECLARED
  CODING_RESULT
  AI_INFERRED
  RECRUITER_VERIFIED
  PROJECT
  CERTIFICATION
}

enum CodingCatalogueStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PlacementProblemStatus {
  NOT_STARTED
  ATTEMPTED
  SOLVED
  REVISION_REQUIRED
}

enum SubmissionType {
  RUN
  PRACTICE
}

enum CodingExecutionMode {
  STDIN_STDOUT
  FUNCTION_BASED
}

enum SubmissionStatus {
  RECEIVED
  VALIDATED
  QUEUED
  DISPATCHED
  PROCESSING
  EVALUATING
  RUNNING
  COMPLETED
  FAILED
  ACCEPTED
  WRONG_ANSWER
  COMPILATION_ERROR
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  OUTPUT_LIMIT_EXCEEDED
  SYSTEM_ERROR
  EXPIRED
  CANCELLED
}

enum Verdict {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  COMPILATION_ERROR
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  OUTPUT_LIMIT_EXCEEDED
  SYSTEM_ERROR
  INTERNAL_ERROR
}

enum InterviewType {
  AI_TECHNICAL
  AI_HR
  AI_BEHAVIORAL
  AI_MIXED
  RECRUITER_TECHNICAL
  RECRUITER_HR
}

enum InterviewStatus {
  DRAFT
  CONFIGURED
  QUESTION_GENERATING
  READY
  SCHEDULED
  IN_PROGRESS
  EVALUATING
  COMPLETED
  CANCELLED
  EXPIRED
}

enum RecruiterInterviewStatus {
  DRAFT
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RecruiterRoundStatus {
  PLANNED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LiveRoomStatus {
  WAITING
  ACTIVE
  COMPLETED
  EXPIRED
}

enum InterviewParticipantRole {
  CANDIDATE
  INTERVIEWER
  OBSERVER
}

enum RescheduleRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum ScorecardStatus {
  DRAFT
  SUBMITTED
  FINALIZED
  CORRECTED
}

enum ConsentType {
  PLATFORM_TERMS
  PRIVACY_POLICY
  PROFILE_DISCOVERY
  RESUME_SHARING
  INTERVIEW_TRANSCRIPT
  AI_CONTEXT
  MEDIA_DEVICE
  RECORDING
  DATA_EXPORT
}

enum ConsentStatus {
  GRANTED
  REVOKED
  EXPIRED
}

enum ModerationStatus {
  FLAGGED
  INVESTIGATION
  EVIDENCE_REVIEW
  DECISION
  APPEAL
  CLOSED
}

enum RecommendationStatus {
  PROPOSED
  APPROVED
  REJECTED
  APPLIED
  EXPIRED
}

enum NotificationType {
  SYSTEM
  APPLICATION
  INTERVIEW
  JOB
  SECURITY
  MODERATION
}

enum FileScanStatus {
  PENDING
  CLEAN
  INFECTED
  REJECTED
  FAILED
  DELETED
}

enum FileRetentionClass {
  RESUME
  INTERVIEW_MEDIA
  MODERATION_EVIDENCE
  EXPORT_TEMP
}

enum AIRequestStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  REFUSED
}

model User {
  id                 String          @id @default(uuid()) @db.Uuid
  email              String          @unique @db.VarChar(320)
  emailNormalized    String          @unique @db.VarChar(320)
  fullName           String?         @db.VarChar(200)
  passwordHash       String?         @db.VarChar(255)
  profileImageUrl    String?         @db.VarChar(2048)
  role               UserRole
  status             AccountStatus   @default(PENDING)
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  failedLoginAttempts  Int             @default(0)
  loginLockedUntil     DateTime?
  suspendedAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  studentProfile     StudentProfile?
  recruiterProfile   RecruiterProfile?
  oauthAccounts      OAuthAccount[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  sessions           UserSession[]
  tokenFamilies      TokenFamily[]
  refreshTokens      RefreshToken[]  @relation("RefreshTokenUser")
  companyMembers     CompanyMember[]
  companyMembershipInvitations CompanyMember[] @relation("CompanyMemberInviter")
  applications       Application[]   @relation("ApplicationStudent")
  createdJobs        Job[]            @relation("JobCreator")
  submissions        CodeSubmission[]
  notifications      Notification[]
  notificationPreference NotificationPreference?
  consents           ConsentRecord[]
  aiUsage            AIUsageRecord[]
  aiEvaluations      AIEvaluation[]
  bookmarks          Bookmark[]
  jobBookmarks       JobBookmark[]
  codingProgress     StudentProblemProgress[]
  sheetProblemProgress SheetProblemProgress[]
  codingSheetEngagements CodingSheetEngagement[]
  placementBookmarks PlacementProblemBookmark[]
  placementNotes    PlacementProblemNote[]
  codeRuns           CodeRun[]
  auditLogs          AuditLog[]       @relation("AuditActor")
  securityEvents     SecurityEvent[]  @relation("SecuritySubject")
  reportedCases      ModerationCase[] @relation("ModerationReporter")
  moderationCases    ModerationCase[] @relation("ModerationSubject")
  createdInterviews  InterviewSession[] @relation("InterviewCreator")
  interviewParticipants InterviewParticipant[]
  authoredNotes      RecruiterNote[]
  verifiedSkills     StudentSkill[]  @relation("SkillVerifier")
  completedTasks     StudyTaskCompletion[]
  createdFiles       StoredFile[]     @relation("FileOwner")
  dataAccesses       DataAccessLog[] @relation("DataAccessActor")
  subjectDataAccesses DataAccessLog[] @relation("DataAccessSubject")
  createdAuditEvents AuditLog[]       @relation("AuditCreatedBy")
  resolvedSecurityEvents SecurityEvent[] @relation("SecurityResolver")
  decidedModerationCases ModerationCase[] @relation("ModerationDecider")
  moderationActions ModerationAction[]
  appeals           Appeal[]
  interviewAnswers  InterviewAnswer[] @relation("InterviewAnswerParticipant")
  interviewEvaluations InterviewEvaluation[] @relation("InterviewEvaluator")
  interviewFeedback InterviewFeedback[] @relation("InterviewFeedbackAuthor")
  submittedVerifications CompanyVerification[] @relation("VerificationSubmitter")
  reviewedVerifications CompanyVerification[] @relation("VerificationReviewer")
  changedStageHistory ApplicationStageHistory[] @relation("StageChangedBy")
  updatedAIConfigurations AIModelConfiguration[] @relation("AIConfigUpdater")
  decidedAppeals Appeal[] @relation("AppealDecider")
  recruiterInterviewsCreated RecruiterInterview[] @relation("RecruiterInterviewCreator")
  recruiterInterviewParticipants RecruiterInterviewParticipant[]
  interviewAvailabilities InterviewAvailability[]
  rescheduleRequestsCreated InterviewRescheduleRequest[] @relation("RescheduleRequester")
  rescheduleRequestsReviewed InterviewRescheduleRequest[] @relation("RescheduleReviewer")
  scorecardsSubmitted RecruiterScorecard[] @relation("ScorecardSubmitter")
  scorecardsFinalized RecruiterScorecard[] @relation("ScorecardFinalizer")
  scorecardCorrections RecruiterScorecardCorrection[]
  recruiterInterviewAudits RecruiterInterviewAudit[]
  receivedOffers    Offer[] @relation("OfferStudent")
  createdOffers     Offer[] @relation("OfferCreator")
  liveRoomTokens LiveInterviewRoomToken[]
  liveRoomParticipants LiveInterviewParticipant[]
  dsaSheetProgress DSASheetProgress[]
  studentTargetRoles StudentTargetRole[]
  integrityEvents IntegrityEvent[]
  @@index([role, status])
  @@index([status, createdAt])
}

model UserSession {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  sessionTokenHash   String   @unique @db.VarChar(255)
  ipAddress          String?  @db.VarChar(64)
  userAgent          String?  @db.VarChar(512)
  expiresAt          DateTime
  lastActivityAt     DateTime @default(now())
  revokedAt          DateTime?
  revokeReason       String?
  createdAt          DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenFamily        TokenFamily?
  @@index([userId, revokedAt, expiresAt])
  @@index([userId, createdAt])
}

model TokenFamily {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  sessionId     String?        @unique @db.Uuid
  expiresAt     DateTime
  revokedAt     DateTime?
  revokeReason  String?        @db.VarChar(100)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  session       UserSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]
  @@index([userId, revokedAt, expiresAt])
}

model RefreshToken {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  tokenHash         String        @unique @db.VarChar(255)
  familyId          String        @db.Uuid
  replacedById      String?       @db.Uuid
  replacedBy        RefreshToken? @relation("RefreshTokenReplacedBy", fields: [replacedById], references: [id], onDelete: SetNull)
  replacedFrom      RefreshToken? @relation("RefreshTokenReplacedBy")
  expiresAt         DateTime
  revokedAt         DateTime?
  revokeReason      String?
  createdAt         DateTime      @default(now())
  user              User          @relation("RefreshTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  family            TokenFamily   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  @@index([userId, familyId, revokedAt])
  @@index([familyId, expiresAt])
  @@unique([replacedById])
}

model OAuthAccount {
  id                  String       @id @default(uuid()) @db.Uuid
  userId              String       @db.Uuid
  provider            OAuthProvider
  providerAccountId   String       @db.VarChar(255)
  providerEmail       String?      @db.VarChar(320)
  providerEmailVerified Boolean?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId, provider])
}

model EmailVerificationToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique @db.VarChar(64)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique @db.VarChar(64)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model StudentProfile {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @unique @db.Uuid
  firstName         String        @db.VarChar(100)
  lastName          String        @db.VarChar(100)
  phone             String?       @db.VarChar(32)
  headline          String?       @db.VarChar(180)
  bio               String?
  location          String?       @db.VarChar(160)
  githubUrl         String?       @db.VarChar(500)
  linkedinUrl       String?       @db.VarChar(500)
  portfolioUrl      String?       @db.VarChar(500)
  discoverable      Boolean       @default(false)
  readinessScore    Decimal?      @db.Decimal(5, 2)
  readinessFormulaVersion String?
  readinessCalculatedAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  educations        Education[]
  skills            StudentSkill[]
  projects          Project[]
  experiences       Experience[]
  certifications    Certification[]
  resumes           Resume[]
  studyPlans        StudyPlan[]
  profileSuggestions ProfileSuggestion[]
  learningProgress  LearningProgress[]
  activities        StudentActivity[]
  @@index([discoverable, updatedAt])
}

model Education {
  id                String        @id @default(uuid()) @db.Uuid
  studentId         String        @db.Uuid
  institution       String        @db.VarChar(200)
  degree            String?       @db.VarChar(160)
  fieldOfStudy      String?       @db.VarChar(160)
  startDate         DateTime?
  endDate           DateTime?
  grade             Decimal?      @db.Decimal(5, 2)
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  @@index([studentId, endDate])
}

model Project {
  id                String        @id @default(uuid()) @db.Uuid
  studentId         String        @db.Uuid
  name              String        @db.VarChar(200)
  description       String?
  url               String?       @db.VarChar(500)
  repositoryUrl     String?       @db.VarChar(500)
  technologies      Json?
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  @@index([studentId, createdAt])
}

model Experience {
  id                String        @id @default(uuid()) @db.Uuid
  studentId         String        @db.Uuid
  organization      String        @db.VarChar(200)
  title             String        @db.VarChar(160)
  description       String?
  startDate         DateTime?
  endDate           DateTime?
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  @@index([studentId, endDate])
}

model Certification {
  id                String        @id @default(uuid()) @db.Uuid
  studentId         String        @db.Uuid
  name              String        @db.VarChar(200)
  issuer            String?       @db.VarChar(200)
  credentialUrl     String?       @db.VarChar(500)
  issuedAt          DateTime?
  expiresAt         DateTime?
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  @@index([studentId, expiresAt])
}

model Skill {
  id                String        @id @default(uuid()) @db.Uuid
  name              String        @unique @db.VarChar(120)
  category          String?       @db.VarChar(80)
  students          StudentSkill[]
  jobSkills         JobSkill[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model StudentSkill {
  id                String        @id @default(uuid()) @db.Uuid
  studentId         String        @db.Uuid
  skillId           String        @db.Uuid
  evidenceType      EvidenceType
  proficiency       Decimal?      @db.Decimal(5, 2)
  verifiedAt        DateTime?
  verifiedByUserId  String?       @db.Uuid
  sourceId          String?       @db.Uuid
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill             Skill         @relation(fields: [skillId], references: [id], onDelete: Restrict)
  verifiedBy        User?         @relation("SkillVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  @@index([studentId, skillId, evidenceType])
  @@index([skillId, evidenceType, verifiedAt])
  @@unique([studentId, skillId, evidenceType, sourceId])
}

model RecruiterProfile {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @unique @db.Uuid
  jobTitle          String?       @db.VarChar(160)
  department        String?       @db.VarChar(160)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Company {
  id                String        @id @default(uuid()) @db.Uuid
  name              String        @db.VarChar(200)
  slug              String        @unique @default(cuid()) @db.VarChar(240)
  officialEmailDomain String?      @db.VarChar(253)
  website           String?       @db.VarChar(500)
  logoUrl           String?       @db.VarChar(2048)
  description       String?
  metadata          Json?
  status            CompanyStatus @default(PENDING_VERIFICATION)
  verifiedAt        DateTime?
  members           CompanyMember[]
  jobs              Job[]
  verifications     CompanyVerification[]
  recruiterInterviews RecruiterInterview[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  @@index([status, name])
  @@index([officialEmailDomain])
}

model CompanyMember {
  id                String            @id @default(uuid()) @db.Uuid
  companyId         String            @db.Uuid
  userId            String            @db.Uuid
  role              CompanyMemberRole
  active            Boolean           @default(true)
  invitedAt         DateTime          @default(now())
  invitedByUserId   String?           @db.Uuid
  invitationEmail   String?           @db.VarChar(320)
  invitationTokenHash String?         @unique @db.VarChar(64)
  invitationExpiresAt DateTime?
  acceptedAt        DateTime?
  deactivatedAt     DateTime?
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  invitedBy         User?             @relation("CompanyMemberInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  @@unique([companyId, userId])
  @@index([userId, active])
  @@index([companyId, role, active])
}

model CompanyVerification {
  id                String        @id @default(uuid()) @db.Uuid
  companyId         String        @db.Uuid
  submittedByUserId String        @db.Uuid
  reviewedByUserId  String?       @db.Uuid
  status            CompanyStatus
  evidenceFileId    String?       @db.Uuid
  note              String?
  submittedAt       DateTime      @default(now())
  reviewedAt        DateTime?
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  submittedBy       User          @relation("VerificationSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  reviewedBy        User?         @relation("VerificationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  evidenceFile      StoredFile?   @relation("VerificationEvidence", fields: [evidenceFileId], references: [id], onDelete: SetNull)
  @@index([companyId, status, submittedAt])
}

model Job {
  id                String          @id @default(uuid()) @db.Uuid
  companyId         String          @db.Uuid
  createdByUserId   String          @db.Uuid
  title             String          @db.VarChar(200)
  description       String
  location          String?         @db.VarChar(160)
  employmentType    EmploymentType
  salaryMin         Decimal?        @db.Decimal(12, 2)
  salaryMax         Decimal?        @db.Decimal(12, 2)
  educationRequirement String?
  experienceRequirement String?
  status            JobStatus       @default(DRAFT)
  deadline          DateTime?
  publishedAt       DateTime?
  closedAt          DateTime?
  metadata          Json?
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy         User            @relation("JobCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  skills            JobSkill[]
  applications      Application[]
  bookmarks         JobBookmark[]
  offers            Offer[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  @@index([companyId, status, deadline])
  @@index([status, publishedAt])
}

model JobBookmark {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  jobId     String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@unique([userId, jobId])
  @@index([userId, createdAt])
}

model JobSkill {
  id                String        @id @default(uuid()) @db.Uuid
  jobId             String        @db.Uuid
  skillId           String        @db.Uuid
  required          Boolean       @default(true)
  job               Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill             Skill         @relation(fields: [skillId], references: [id], onDelete: Restrict)
  @@unique([jobId, skillId])
}

model Application {
  id                String            @id @default(uuid()) @db.Uuid
  jobId             String            @db.Uuid
  studentUserId     String            @db.Uuid
  reapplicationNumber Int             @default(1)
  resumeId          String?           @db.Uuid
  resumeVersionId   String?           @db.Uuid
  status            ApplicationStatus @default(APPLIED)
  consentSnapshot   Json
  internalTags      Json          @default("[]")
  offers            Offer[]
  appliedAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  job               Job               @relation(fields: [jobId], references: [id], onDelete: Restrict)
  student           User              @relation("ApplicationStudent", fields: [studentUserId], references: [id], onDelete: Restrict)
  resume            Resume?           @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  resumeVersion     ResumeVersion?    @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  stageHistory      ApplicationStageHistory[]
  notes             RecruiterNote[]
  interviewSessions InterviewSession[]
  recruiterInterviews RecruiterInterview[]
  @@unique([jobId, studentUserId, reapplicationNumber])
  @@index([studentUserId, status, updatedAt])
  @@index([jobId, status, updatedAt])
  @@index([jobId, status, appliedAt])
}

model ApplicationStageHistory {
  id                String            @id @default(uuid()) @db.Uuid
  applicationId     String            @db.Uuid
  fromStatus        ApplicationStatus?
  toStatus          ApplicationStatus
  changedByUserId   String            @db.Uuid
  reason            String?
  createdAt         DateTime          @default(now())
  application       Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy         User              @relation("StageChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)
  @@index([applicationId, createdAt])
  @@index([toStatus, createdAt])
}

model RecruiterNote {
  id                String            @id @default(uuid()) @db.Uuid
  applicationId     String            @db.Uuid
  authorUserId      String            @db.Uuid
  body              String
  private           Boolean           @default(true)
  application       Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author            User              @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  @@index([applicationId, createdAt])
}

model StoredFile {
  id                String              @id @default(uuid()) @db.Uuid
  ownerUserId       String              @db.Uuid
  objectKey         String              @unique @db.VarChar(1000)
  originalName      String              @db.VarChar(255)
  mimeType          String              @db.VarChar(160)
  sizeBytes         Int
  sha256            String              @db.VarChar(64)
  scanStatus        FileScanStatus      @default(PENDING)
  retentionClass    FileRetentionClass
  deletedAt         DateTime?
  owner             User                @relation("FileOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  verificationEvidence CompanyVerification[] @relation("VerificationEvidence")
  resumeVersions    ResumeVersion[]
  moderationEvidence ModerationEvidence[]
  @@index([ownerUserId, scanStatus])
  @@index([retentionClass, deletedAt])
}

model Resume {
  id                String            @id @default(uuid()) @db.Uuid
  studentId         String            @db.Uuid
  title             String            @db.VarChar(200)
  visibility        String            @default("PRIVATE")
  activeVersionId   String?           @unique @db.Uuid
  deletedAt         DateTime?
  student           StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  activeVersion     ResumeVersion?   @relation("ResumeActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  versions          ResumeVersion[]  @relation("ResumeVersions")
  applications      Application[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  @@index([studentId, deletedAt])
}

model ResumeVersion {
